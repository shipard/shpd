{
    "name": "shipard/shipard",
    "require": {
        "php": ">=8.5",
        "dibi/dibi": "^5.0",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shipard\\": "src/",
            "Shipard\\Module\\Base\\Persons\\": "modules/base/persons/src/",
            "Shipard\\Module\\Core\\System\\": "modules/core/system/src/",
            "Shipard\\Module\\Economy\\Codebooks\\": "modules/economy/codebooks/src/",
            "Shipard\\Module\\Install\\Base\\": "modules/install/base/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipard\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/shpd-server", "bin/shpd-ds"]
}
