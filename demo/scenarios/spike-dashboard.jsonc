// Pilotní scénář spike (tasks/video-runner-spike.md) — smysl je protáhnout
// pipeline prvními daty, ne natočit použitelnou ukázku. Obsah je jedno.
//
// Selektory jsou CSS, protože v aplikaci zatím není ani jeden `data-testid`.
// Je to známý dluh, ne vzor k následování — viz tools/video-runner/README.md.
{
  "id": "spike-dashboard",

  // capture.w/h = pixely rawu, scale = deviceScaleFactor.
  // CSS viewport z toho vychází 1280×800 při dvojnásobné hustotě.
  //
  // `output` neuvádí rozměr, takže se nezmenšuje: video vyjde v rozlišení
  // záznamu (2560×1600) a na stránce se zobrazí v šířce 1280 CSS px, aby
  // ho retina displeje neupscalovaly.
  "capture": { "w": 2560, "h": 1600, "scale": 2 },
  "output":  { "fps": 30 },

  "steps": [
    { "goto": "/app/" },
    { "waitFor": ".shpd-shell", "pause": 1 },
    { "caption": "Testovací klip — protažení pipeline", "pause": 2.5 },
    { "hover": ".shpd-sidebar", "pause": 1 },
    { "highlight": ".shpd-sidebar", "for": 1.5, "pause": 1.5 },

    // Scroll je jediná skutečná animace, kterou produkt má, a zároveň
    // jediné místo, kde by varianta záznamu `cdp` mohla nestíhat. Proto
    // je v pilotním scénáři: klik do navigace, přejezd na obsah, scroll.
    //
    // `:has-text()` je Playwrightí selektor, ne CSS, a váže se na český
    // popisek — dvojnásobný dluh do doby, než v aplikaci budou
    // `data-testid`.
    { "caption": "Klik do navigace a scroll v obsahu" },
    { "click": ".shpd-navtree__item:has-text('Došlá pošta')" },
    // Scrollovat se musí nad seznamem řádků, ne nad `.shpd-content`:
    // střed obsahu padne na detailní panel vpravo, který se nescrolluje.
    { "waitFor": ".shpd-viewer__rows", "pause": 1.5 },
    { "hover": ".shpd-viewer__rows", "pause": 0.5 },
    { "scroll": 500, "over": 0.4, "pause": 1 },
    { "scroll": -500, "over": 1.2, "pause": 1 },

    { "caption": null, "pause": 1 }
  ]
}
