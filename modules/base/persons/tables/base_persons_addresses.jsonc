{
    "tableId": 204,
    "name": "Addresses",
    "name:cs": "Adresy",
    "name:en": "Addresses",

    "displayPattern": "{display_line}",

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "address",
            "name": "Address",
            "name:cs": "Adresa",
            "name:en": "Address"
        },
        {
            "id": "geo",
            "name": "Geolocation",
            "name:cs": "Geolokace",
            "name:en": "Geolocation"
        },
        {
            "id": "display",
            "name": "Display",
            "name:cs": "Zobrazení",
            "name:en": "Display"
        },
        {
            "id": "validity",
            "name": "Validity",
            "name:cs": "Platnost",
            "name:en": "Validity"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "person",
            "name": "Person",
            "name:cs": "Osoba",
            "name:en": "Person",
            "type": "int",
            "nullable": false,
            "reference": "base_persons_persons",
            "group": "identity"
        },
        {
            "id": "address_type",
            "name": "Address type",
            "name:cs": "Typ adresy",
            "name:en": "Address type",
            "type": "enumInt",
            "default": 0,
            "cfgItem": "base.persons.addressTypes",
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "place_reg_type",
            "name": "Place register type",
            "name:cs": "Typ registru místa",
            "name:en": "Place register type",
            "type": "enumString",
            "length": 5,
            "cfgItem": "base.persons.placeRegTypes",
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "place_reg_id",
            "name": "Place register ID",
            "name:cs": "Identifikátor místa",
            "name:en": "Place register ID",
            "type": "varchar",
            "length": 20,
            "nullable": true,
            "group": "identity"
        },

        // --- address ---

        {
            "id": "is_standardized",
            "name": "Standardized address",
            "name:cs": "Standardizovaná adresa",
            "name:en": "Standardized address",
            "type": "boolean",
            "default": 0,
            "group": "address"
        },
        {
            "id": "street",
            "name": "Street",
            "name:cs": "Ulice",
            "name:en": "Street",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "house_number",
            "name": "House number",
            "name:cs": "Číslo popisné",
            "name:en": "House number",
            "type": "varchar",
            "length": 20,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "orientation_number",
            "name": "Orientation number",
            "name:cs": "Číslo orientační",
            "name:en": "Orientation number",
            "type": "varchar",
            "length": 20,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "city",
            "name": "City",
            "name:cs": "Obec",
            "name:en": "City",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "city_part",
            "name": "City part",
            "name:cs": "Část obce",
            "name:en": "City part",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "district",
            "name": "District",
            "name:cs": "Městský obvod",
            "name:en": "District",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "zip",
            "name": "ZIP code",
            "name:cs": "PSČ",
            "name:en": "ZIP code",
            "type": "varchar",
            "length": 20,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "country",
            "name": "Country",
            "name:cs": "Země",
            "name:en": "Country",
            "type": "varchar",
            "length": 2,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "registry_code",
            "name": "Registry code",
            "name:cs": "Kód adresního místa",
            "name:en": "Registry code",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "address"
        },
        {
            "id": "division",
            "name": "Administrative division",
            "name:cs": "Administrativní jednotka",
            "name:en": "Administrative division",
            "type": "int",
            "nullable": true,
            "reference": "world_divisions",
            "group": "address"
        },

        // --- geo ---

        {
            "id": "latitude",
            "name": "Latitude",
            "name:cs": "Zeměpisná šířka",
            "name:en": "Latitude",
            "type": "numeric",
            "precision": 9,
            "scale": 6,
            "nullable": true,
            "group": "geo"
        },
        {
            "id": "longitude",
            "name": "Longitude",
            "name:cs": "Zeměpisná délka",
            "name:en": "Longitude",
            "type": "numeric",
            "precision": 9,
            "scale": 6,
            "nullable": true,
            "group": "geo"
        },
        {
            "id": "manual_gps",
            "name": "Manual GPS",
            "name:cs": "Manuální zaměření",
            "name:en": "Manual GPS",
            "type": "boolean",
            "default": 0,
            "group": "geo"
        },

        // --- display ---

        {
            "id": "display_line",
            "name": "Address (one line)",
            "name:cs": "Adresa (jednořádková)",
            "name:en": "Address (one line)",
            "type": "varchar",
            "length": 500,
            "nullable": true,
            "group": "display"
        },
        {
            "id": "display_block",
            "name": "Address (multiline)",
            "name:cs": "Adresa (víceřádková)",
            "name:en": "Address (multiline)",
            "type": "text",
            "nullable": true,
            "group": "display"
        },

        // --- validity ---

        {
            "id": "order_pos",
            "name": "Order",
            "name:cs": "Pořadí",
            "name:en": "Order",
            "type": "smallint",
            "default": 0,
            "group": "validity"
        },
        {
            "id": "valid_from",
            "name": "Valid from",
            "name:cs": "Platnost od",
            "name:en": "Valid from",
            "type": "date",
            "nullable": true,
            "group": "validity"
        },
        {
            "id": "valid_to",
            "name": "Valid to",
            "name:cs": "Platnost do",
            "name:en": "Valid to",
            "type": "date",
            "nullable": true,
            "group": "validity"
        },
        {
            "id": "note",
            "name": "Note",
            "name:cs": "Poznámka",
            "name:en": "Note",
            "type": "text",
            "nullable": true,
            "group": "validity"
        }
    ],

    "indexes": [
        {
            "id": "idx_person",
            "type": "index",
            "columns": [
                {"column": "person"},
                {"column": "address_type"},
                {"column": "order_pos", "order": "ASC"}
            ]
        },
        {
            "id": "idx_city_street",
            "type": "index",
            "columns": [
                {"column": "city"},
                {"column": "street"}
            ]
        },
        {
            "id": "idx_zip",
            "type": "index",
            "columns": [
                {"column": "zip"}
            ]
        },
        {
            "id": "idx_registry_code",
            "type": "index",
            "columns": [
                {"column": "registry_code"}
            ]
        },
        {
            "id": "idx_division",
            "type": "index",
            "columns": [
                {"column": "division"}
            ]
        },
        {
            "id": "idx_place_reg",
            "type": "index",
            "columns": [
                {"column": "place_reg_type"},
                {"column": "place_reg_id"}
            ]
        },
        {
            "id": "ft_display_line",
            "type": "fulltext",
            "columns": [
                {"column": "display_line"}
            ]
        }
    ]
}
