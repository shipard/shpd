{
    // core.chat.settings
    //
    // Nastavení vestavěného AI chatu. Ve Fázi 2a obsahuje jen systémový prompt;
    // čte ho ChatController přes ConfigRuntime. Zatím statické, per-DS ladění
    // přijde později. Při chybějícím compiled configu controller použije
