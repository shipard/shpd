{
    "tableId": 411,
    "name": "Chat messages",
    "name:cs": "Zprávy chatu",
    "name:en": "Chat messages",

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "content",
            "name": "Content",
            "name:cs": "Obsah",
            "name:en": "Content"
        },
        {
            "id": "telemetry",
            "name": "Telemetry",
            "name:cs": "Telemetrie",
            "name:en": "Telemetry"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "conversation",
            "name": "Conversation",
            "name:cs": "Konverzace",
            "name:en": "Conversation",
            "type": "int",
            "nullable": false,
            "reference": "core_chat_conversations",
            "group": "identity"
        },
        {
            "id": "seq",
            "name": "Sequence",
            "name:cs": "Pořadí",
            "name:en": "Sequence",
            "type": "int",
            "nullable": false,
            "default": 0,
            "group": "identity"
        },
        {
            "id": "role",
            "name": "Role",
            "name:cs": "Role",
            "name:en": "Role",
            "type": "enumString",
            "length": 12,
            "nullable": false,
            "cfgItem": "core.chat.messageRoles",
            "default": "user",
            "group": "identity"
        },
        {
            "id": "kind",
            "name": "Kind",
            "name:cs": "Druh",
            "name:en": "Kind",
            "type": "enumString",
            "length": 16,
            "nullable": false,
            "cfgItem": "core.chat.messageKinds",
            "default": "user_text",
            "group": "identity"
        },

        // --- content (JSON pole bloků ve formátu Anthropic) ---

        {
            "id": "content",
            "name": "Content blocks (JSON)",
            "name:cs": "Bloky obsahu (JSON)",
            "name:en": "Content blocks (JSON)",
            "type": "longtext",
            "nullable": false,
            "group": "content"
        },

        // --- telemetry (per asistentský tah) ---

        {
            "id": "tokens_input",
            "name": "Input tokens",
            "name:cs": "Vstupní tokeny",
            "name:en": "Input tokens",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "tokens_output",
            "name": "Output tokens",
            "name:cs": "Výstupní tokeny",
            "name:en": "Output tokens",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "cost",
            "name": "Cost",
            "name:cs": "Náklady",
            "name:en": "Cost",
            "type": "numeric",
            "precision": 14,
            "scale": 6,
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "model_name",
            "name": "Model name",
            "name:cs": "Název modelu",
            "name:en": "Model name",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "telemetry"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        }
    ],

    "indexes": [
        {
            "id": "idx_conversation",
            "type": "index",
            "columns": [
                {"column": "conversation"}
            ]
        },
        {
            "id": "idx_conversation_seq",
            "type": "index",
            "columns": [
                {"column": "conversation"},
                {"column": "seq"}
            ]
        }
    ]
}
