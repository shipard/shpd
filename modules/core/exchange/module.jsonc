{
    "id": "core.exchange",
    "name": "Exchange formats",
    "name:cs": "Výměnné formáty",
    "name:en": "Exchange formats",
    "description": "Canonical exchange formats for documents and other entities",
    "description:cs": "Kanonické výměnné formáty pro doklady a další entity",
    "description:en": "Canonical exchange formats for documents and other entities",

    "dependencies": [
        "docs.core",
        "base.persons",
        "economy.items",
        "economy.bank",
        "core.units",
        "world.vat",
        "core.mail",
        "core.attachments"
    ],

    "tables": [
        "core_exchange_tag_rules"
    ],

    "config": [
        { "id": "core.exchange.contentTags", "file": "config/contentTags.jsonc" }
    ],

    "documentEventHandlers": [
        {
            // Učení pravidel IČO → obsahový štítek z apply dokladu s LLM
            // štítkem (D22, tasks/content-tag-enrichment.md).
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Core\\Exchange\\Enrich\\ContentTagRuleCaptureHandler",
            "events": ["stateChanged"]
        }
    ]

    // No documentClasses — uses existing Document/TableGateway.
    // No viewers — backend service module.
}
