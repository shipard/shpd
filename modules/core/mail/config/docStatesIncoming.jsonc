{
    // core.mail.docStatesIncoming
    //
    // Stavová mapa došlých zpráv (core_mail_incoming_messages) — čistě
    // uživatelský workflow, srovnaný se zbytkem aplikace. Status AI
    // analýzy žije v ortogonálním sloupci `analysis_state`
    // (cfgItem core.mail.analysisStates).
    //
    // Stavový automat:
    //   Nová      → K řešení | Hotovo | Archiv | Koš
    //   K řešení  → Hotovo | Nová | Archiv | Koš
    //   Hotovo    → Archiv | Koš | Nová
    //   Archiv    → Nová | Koš
    //   Koš       → Nová
    //
    // Přechod 10→20 v praxi nastavuje AI pipeline (result s dokumenty),
    // v goto zůstává i pro manuální použití.
    //
    // Mapování na stateStyle (viz docs/doc-states.md §6):
    //   concept   — žlutá  — Nová
    //   confirmed — modrá  — K řešení
    //   done      — zelená — Hotovo
    //   archive   — šedá   — Archiv
    //   trash     — černá  — Koš

    "10": {
        "stateName": "New",
        "stateName:cs": "Nová",
        "stateName:en": "New",
        "actionName": "Mark as new",
        "actionName:cs": "Vrátit na Novou",
        "actionName:en": "Mark as new",
        "stateStyle": "concept",
        "mainState": 1,
        "viewGroup": "active",
        "closeForm": 0,
        "goto": [20, 40, 80, 90]
    },

    "20": {
        "stateName": "In progress",
        "stateName:cs": "K řešení",
        "stateName:en": "In progress",
        "actionName": "Mark for follow-up",
        "actionName:cs": "Označit k řešení",
        "actionName:en": "Mark for follow-up",
        "stateStyle": "confirmed",
        "mainState": 2,
        "viewGroup": "active",
        "closeForm": 0,
        "goto": [40, 10, 80, 90]
    },

    "40": {
        "stateName": "Done",
        "stateName:cs": "Hotovo",
        "stateName:en": "Done",
        "actionName": "Mark as done",
        "actionName:cs": "Označit jako hotovou",
        "actionName:en": "Mark as done",
        "stateStyle": "done",
        "mainState": 3,
        "viewGroup": "active",
        "readOnly": 1,
        "closeForm": 1,
        "goto": [80, 90, 10]
    },

    "80": {
        "stateName": "Archived",
        "stateName:cs": "Archiv",
        "stateName:en": "Archived",
        "actionName": "Archive",
        "actionName:cs": "Archivovat",
        "actionName:en": "Archive",
        "stateStyle": "archive",
        "mainState": 4,
        "viewGroup": "archive",
        "readOnly": 1,
        "closeForm": 1,
        "goto": [10, 90]
    },

    "90": {
        "stateName": "Deleted",
        "stateName:cs": "Smazáno",
        "stateName:en": "Deleted",
        "actionName": "Delete",
        "actionName:cs": "Smazat",
        "actionName:en": "Delete",
        "stateStyle": "trash",
        "mainState": 5,
        "viewGroup": "trash",
        "readOnly": 1,
        "closeForm": 1,
        "goto": [10]
    }
}
