{
    // core.mail.viewerDetailLabels
    //
    // Detail labels for IncomingMessagesViewer. No shared "overview" —
    // tabs are Content / Analyses / Extracted / Original. The `attachments`
    // key is not a tab anymore — it labels the attachments section heading
    // inside the Content tab.

    "tabs": {
        "content": {
            "name": "Content",
            "name:cs": "Obsah",
            "name:en": "Content"
        },
        "attachments": {
            "name": "Attachments",
            "name:cs": "Přílohy",
            "name:en": "Attachments"
        },
        "analyses": {
            "name": "Analyses",
            "name:cs": "Analýzy",
            "name:en": "Analyses"
        },
        "extractedDocuments": {
            "name": "Extracted documents",
            "name:cs": "Extrahované dokumenty",
            "name:en": "Extracted documents"
        },
        "original": {
            "name": "Original",
            "name:cs": "Originál",
            "name:en": "Original"
        }
    }
}
