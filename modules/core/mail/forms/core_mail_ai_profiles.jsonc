{
    "title": "AI profil",
    "title:cs": "AI profil",
    "title:en": "AI profile",
    "titleNew": "Nový AI profil",
    "titleNew:cs": "Nový AI profil",
    "titleNew:en": "New AI profile",
    "tabs": [
        {
            "id": "basic",
            "label": "AI profil",
            "label:cs": "AI profil",
            "label:en": "AI profile",
            "sections": [
                {
                    "columns": [
                        {
                            "elements": [
                                {"type": "input", "column": "profile_id", "required": true},
                                {"type": "input", "column": "name", "required": true},
                                {
                                    "type": "lookup",
                                    "column": "backend",
                                    "required": true,
                                    "placeholder": "Vyberte backend…",
                                    "lookup": {"table": "core_mail_ai_backends", "filter": null}
                                },

                                {"type": "separator", "label": "Záběr", "label:cs": "Záběr", "label:en": "Scope"},
                                {"type": "input", "column": "supported_doc_types", "inputType": "textarea"},
                                {"type": "input", "column": "language", "required": true},

                                {"type": "separator", "label": "Prompt", "label:cs": "Prompt", "label:en": "Prompt"},
                                {"type": "input", "column": "prompt_version"},
                                {"type": "input", "column": "prompt_template", "inputType": "textarea"},

                                {"type": "separator", "label": "Výstup", "label:cs": "Výstup", "label:en": "Output"},
                                {"type": "input", "column": "output_schema", "inputType": "textarea"},
                                {"type": "input", "column": "confidence_thresholds", "inputType": "textarea"},

                                {"type": "separator", "label": "Příznaky", "label:cs": "Příznaky", "label:en": "Flags"},
                                {"type": "input", "column": "is_default"},
                                {"type": "input", "column": "is_active"}
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
