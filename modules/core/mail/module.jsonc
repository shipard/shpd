{
    "id": "core.mail",
    "name": "Mail",
    "name:cs": "Pošta",
    "name:en": "Mail",
    "description": "Incoming and outgoing e-mail messages",
    "description:cs": "Došlá a odchozí pošta",
    "description:en": "Incoming and outgoing e-mail messages",

    "dependencies": [
        "core.system",
        "core.attachments",
        "core.ai",
        "base.persons"
    ],

    "tables": [
        "core_mail_mailboxes",
        "core_mail_incoming_messages",
        "core_mail_message_analyses",
        "core_mail_incoming_idempotency",
        "core_mail_extracted_documents",
        "core_mail_ai_profiles",
        "core_mail_analysis_claims",
        "core_mail_senders",
        "core_mail_outbox",
        "core_mail_outbox_log"
    ],

    // ds-reset chrání AI profily — je to konfigurace (vč. admin úprav
    // name/is_default/is_active a lokálně laděného promptu), ne migrovaná
    // data. Backendy chrání analogicky core.ai.
    // Senders jsou konfigurace (transporty per from adresa); outbox a log
    // jsou data — při resetu se mažou.
    "keepOnReset": [
        "core_mail_ai_profiles",
        "core_mail_senders"
    ],

    // core_mail_incoming_messages má viewer core.mail.incoming (Došlá pošta)
    // a zůstává v hlavní navigaci — do settings nepatří.
    // AI backendy se přesunuly do core.ai (i jejich settingsItem + keepOnReset).
    "settingsItems": [
        { "viewer": "core.mail.mailboxes",          "section": "other", "subsection": "other.mail", "order": 10 },
        { "table": "core_mail_message_analyses",    "section": "other", "subsection": "other.mail", "order": 20 },
        { "table": "core_mail_incoming_idempotency","section": "other", "subsection": "other.mail", "order": 30 },
        { "table": "core_mail_extracted_documents", "section": "other", "subsection": "other.mail", "order": 35 },
        { "viewer": "core.mail.aiProfiles",         "section": "other", "subsection": "other.mail", "order": 50 },
        { "table": "core_mail_analysis_claims",     "section": "other", "subsection": "other.mail", "order": 60 },
        { "table": "core_mail_senders",             "section": "other", "subsection": "other.mail", "order": 70 },
        { "table": "core_mail_outbox",              "section": "other", "subsection": "other.mail", "order": 75 },
        { "table": "core_mail_outbox_log",          "section": "other", "subsection": "other.mail", "order": 80 },
        { "page": "mailOutbound",                   "section": "other", "subsection": "other.mail", "order": 85 }
    ],

    "settingsPages": [
        {
            "id": "mailOutbound",
            "name": "Outbound mail",
            "name:cs": "Odchozí pošta",
            "name:en": "Outbound mail",
            "icon": "mail",
            "fields": [
                {
                    "id": "mail.defaultFrom",
                    "type": "text",
                    "name": "Default from address",
                    "name:cs": "Výchozí adresa odesílatele",
                    "name:en": "Default from address",
                    "hint": "Used when the caller does not specify a from address.",
                    "hint:cs": "Použije se, když volající neurčí adresu odesílatele.",
                    "hint:en": "Used when the caller does not specify a from address.",
                    "maxLength": 200
                }
            ]
        }
    ],

    "viewers": [
        {
            "id": "core.mail.incoming",
            "name": "Incoming messages",
            "name:cs": "Došlá pošta",
            "name:en": "Incoming messages",
            "icon": "mail",
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesViewer",
            "navSection": "_top",
            "navOrder": 30
        },
        {
            "id": "core.mail.mailboxes",
            "name": "Mailboxes",
            "name:cs": "Schránky",
            "name:en": "Mailboxes",
            "icon": "mail",
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxesViewer"
        },
        {
            "id": "core.mail.aiProfiles",
            "name": "AI profiles",
            "name:cs": "AI profily",
            "name:en": "AI profiles",
            "icon": "robot",
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfilesViewer"
        }
    ],

    "forms": [
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesForm"
        }
    ],

    "documentClasses": [
        {
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxDocument"
        },
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessageDocument"
        },
        {
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfileDocument"
        },
        {
            "table": "core_mail_extracted_documents",
            "class": "Shipard\\Module\\Core\\Mail\\ExtractedDocumentDocument"
        }
    ],

    "alertChecks": [
        {
            "id": "core.mail.outbox_health",
            "name": "Outbound mail queue health",
            "name:cs": "Zdraví fronty odchozí pošty",
            "name:en": "Outbound mail queue health",
            "description": "Failed outbound messages in the last 24 h and stuck pending messages (worker or relay down).",
            "description:cs": "Selhané odchozí zprávy za posledních 24 h a zaseklé pending zprávy (worker nebo relay leží).",
            "description:en": "Failed outbound messages in the last 24 h and stuck pending messages (worker or relay down).",
            "class": "Shipard\\Core\\Mail\\MailOutboxAlertCheck",
            "severity": "warning",
            "interval": "15m",
            "tags": ["mail"]
        }
    ],

    "documentEventHandlers": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Core\\Mail\\SupplierCodeCaptureHandler",
            "events": ["stateChanged"]
        }
    ],

    "config": [
        {
            "id": "core.mail.primaryTypes",
            "file": "config/primaryTypes.jsonc"
        },
        {
            "id": "core.mail.docStatesIncoming",
            "file": "config/docStatesIncoming.jsonc"
        },
        {
            "id": "core.mail.analysisStates",
            "file": "config/analysisStates.jsonc"
        },
        {
            "id": "core.mail.primaryTypeSources",
            "file": "config/primaryTypeSources.jsonc"
        },
        {
            "id": "core.mail.extractedDocStates",
            "file": "config/extractedDocStates.jsonc"
        },
        {
            "id": "core.mail.extractedDocTypes",
            "file": "config/extractedDocTypes.jsonc"
        },
        {
            "id": "core.mail.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "core.mail.viewerDefaults",
            "file": "config/viewerDefaults.jsonc"
        }
    ]
}
