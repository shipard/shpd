{
    "id": "core.mail",
    "name": "Mail",
    "name:cs": "Pošta",
    "name:en": "Mail",
    "description": "Incoming and outgoing e-mail messages (Phase 1: incoming only)",
    "description:cs": "Došlá a odeslaná pošta (Fáze 1: pouze došlá)",
    "description:en": "Incoming and outgoing e-mail messages (Phase 1: incoming only)",

    "dependencies": [
        "core.system",
        "core.attachments",
        "base.persons"
    ],

    "tables": [
        "core_mail_mailboxes",
        "core_mail_incoming_messages",
        "core_mail_message_analyses",
        "core_mail_incoming_idempotency",
        "core_mail_extracted_documents",
        "core_mail_ai_backends",
        "core_mail_ai_profiles",
        "core_mail_analysis_claims"
    ],

    // ds-reset chrání jen AI backend kvůli zašifrovanému API klíči
    // (ai-analyzer-set-key). Schránky, profily, zprávy, analýzy
    // i extrahované doklady se resetují.
    "keepOnReset": [
        "core_mail_ai_backends"
    ],

    // core_mail_incoming_messages má viewer core.mail.incoming (Došlá pošta)
    // a zůstává v hlavní navigaci — do settings nepatří.
    "settingsItems": [
        { "viewer": "core.mail.mailboxes",          "section": "other", "subsection": "other.mail", "order": 10 },
        { "table": "core_mail_message_analyses",    "section": "other", "subsection": "other.mail", "order": 20 },
        { "table": "core_mail_incoming_idempotency","section": "other", "subsection": "other.mail", "order": 30 },
        { "viewer": "core.mail.aiBackends",         "section": "other", "subsection": "other.mail", "order": 40 },
        { "viewer": "core.mail.aiProfiles",         "section": "other", "subsection": "other.mail", "order": 50 },
        { "table": "core_mail_analysis_claims",     "section": "other", "subsection": "other.mail", "order": 60 }
    ],

    "viewers": [
        {
            "id": "core.mail.incoming",
            "name": "Incoming messages",
            "name:cs": "Došlá pošta",
            "name:en": "Incoming messages",
            "icon": "mail",
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesViewer"
        },
        {
            "id": "core.mail.mailboxes",
            "name": "Mailboxes",
            "name:cs": "Schránky",
            "name:en": "Mailboxes",
            "icon": "mail",
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxesViewer"
        },
        {
            "id": "core.mail.aiBackends",
            "name": "AI backends",
            "name:cs": "AI backendy",
            "name:en": "AI backends",
            "icon": "robot",
            "table": "core_mail_ai_backends",
            "class": "Shipard\\Module\\Core\\Mail\\AIBackendsViewer"
        },
        {
            "id": "core.mail.aiProfiles",
            "name": "AI profiles",
            "name:cs": "AI profily",
            "name:en": "AI profiles",
            "icon": "robot",
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfilesViewer"
        }
    ],

    "lookups": [
        {
            "table": "core_mail_ai_backends",
            "class": "Shipard\\Module\\Core\\Mail\\AIBackendLookup"
        }
    ],

    "forms": [
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesForm"
        }
    ],

    "documentClasses": [
        {
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxDocument"
        },
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessageDocument"
        },
        {
            "table": "core_mail_ai_backends",
            "class": "Shipard\\Module\\Core\\Mail\\AIBackendDocument"
        },
        {
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfileDocument"
        },
        {
            "table": "core_mail_extracted_documents",
            "class": "Shipard\\Module\\Core\\Mail\\ExtractedDocumentDocument"
        }
    ],

    "config": [
        {
            "id": "core.mail.primaryTypes",
            "file": "config/primaryTypes.jsonc"
        },
        {
            "id": "core.mail.docStatesIncoming",
            "file": "config/docStatesIncoming.jsonc"
        },
        {
            "id": "core.mail.extractedDocStates",
            "file": "config/extractedDocStates.jsonc"
        },
        {
            "id": "core.mail.extractedDocTypes",
            "file": "config/extractedDocTypes.jsonc"
        },
        {
            "id": "core.mail.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "core.mail.viewerDefaults",
            "file": "config/viewerDefaults.jsonc"
        }
    ]
}
