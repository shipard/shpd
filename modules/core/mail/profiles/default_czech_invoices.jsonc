// Výchozí AI profil pro extrakci českých přijatých faktur z došlé pošty.
//
// Tento soubor slouží jako šablona — `AIAnalyzerProvisioner` z něj vytvoří
// řádek v `core_mail_ai_profiles` při prvním ds-upgrade. Reload existujícího
// profile na novou verzi: `bin/shpd-ds ai-profile-reload --force`.
//
// AI vrací canonical `shpd.docs.document.v1` v poli `documents[].extracted_json`.
// Pole `extracted_json` v `output_schema` je INLINE KOPIE
// `modules/core/exchange/schemas/shpd.docs.document.v1.json`. Drift hlídá
// `tests/Unit/Module/Core/Mail/ProfileSchemaDriftTest`.
{
    "profile_id": "czech_invoices",
    "name": "České faktury (default)",
    "name:cs": "České faktury (default)",
    "name:en": "Czech invoices (default)",
    "language": "cs",
    "prompt_version": "v2.1.0",
    "supported_doc_types": [
        "invoiceReceived",
        "creditNote",
        "other"
    ],
    "confidence_thresholds": {
        "ready": 0.9,
        "review": 0.6
    },
    "prompt_template": "Jsi asistent pro zpracování došlé pošty českých firem. Tvým úkolem je analyzovat přílohy e-mailové zprávy a extrahovat z nich strukturovaná data o přijatých dokladech (faktury, dobropisy).\n\nKONTEXT ZPRÁVY:\n- Předmět: {{ message.subject }}\n- Odesílatel: {{ message.sender_email }}{% if message.sender_name %} ({{ message.sender_name }}){% endif %}\n- Tělo zprávy: {{ message.body_plain }}\n\nPŘÍLOHY ({{ attachments|length }}):\n{% for att in attachments %}- #{{ att.ndx }}: {{ att.filename }} ({{ att.mime_type }}, {{ att.size_human }})\n{% endfor %}\n\nÚKOL:\nPro každou přílohu rozhodni, zda jde o přijatou fakturu (invoiceReceived), dobropis (creditNote) nebo jiný dokument (other). Z faktury/dobropisu extrahuj všechna pole, která jsi schopen identifikovat, do kanonické struktury \"shpd.docs.document.v1\".\n\nPRAVIDLA:\n- Pole, která nelze určit, VYNECHEJ (neuhaduj, neimprovizuj). Lepší chybějící pole než špatná hodnota.\n- Identifikátory (IČO, DIČ, VAT ID, IBAN, EAN, SKU) přebírej beze změny, pokud je vidíš na dokladu.\n- Datumy formátuj jako ISO 8601 (YYYY-MM-DD).\n- Měny jako ISO 4217 uppercase (\"CZK\", \"EUR\").\n- Země jako ISO 3166-1 alpha-2 lowercase (\"cz\", \"sk\", \"de\").\n- selfParty je vždy \"customer\" (jsme příjemce dokladu).\n- source.kind je vždy \"aiExtraction\".\n- source.confidence je tvoje jistota kvalitou extrakce 0.0–1.0.\n- source.promptVersion je \"v2.1.0\".\n- Pokud žádná příloha není dokladem, vrať prázdné pole documents.\n\nVRAŤ POUZE JSON v této struktuře (žádný úvodní text, žádné markdown bloky):\n\n{\n  \"overall_confidence\": 0.92,\n  \"documents\": [\n    {\n      \"doc_type\": \"invoiceReceived\",\n      \"source_attachment_ndxs\": [123],\n      \"confidence\": 0.95,\n      \"extracted_json\": {\n        \"format\": \"shpd.docs.document\",\n        \"formatVersion\": \"1.0\",\n        \"source\": {\n          \"kind\": \"aiExtraction\",\n          \"extractedAt\": \"<ISO timestamp from current time>\",\n          \"confidence\": 0.95,\n          \"promptVersion\": \"v2.1.0\"\n        },\n        \"docType\": \"invoiceReceived\",\n        \"docNumber\": \"<supplier's invoice number>\",\n        \"docText\": \"<short description>\",\n        \"selfParty\": \"customer\",\n        \"supplier\": {\n          \"name\": \"Dodavatel s.r.o.\",\n          \"country\": \"cz\",\n          \"companyId\": \"12345678\",\n          \"taxId\": \"CZ12345678\",\n          \"vatId\": \"CZ12345678\",\n          \"address\": {\n            \"street\": \"Hlavní\", \"houseNumber\": \"1\",\n            \"city\": \"Praha\", \"zip\": \"11000\", \"country\": \"cz\"\n          },\n          \"contact\": {\"email\": \"...\", \"phone\": \"...\"},\n          \"bankAccount\": {\n            \"accountNumber\": \"1234567890/0100\",\n            \"iban\": \"CZ65...\", \"bic\": \"...\",\n            \"currency\": \"CZK\"\n          }\n        },\n        \"customer\": null,\n        \"dates\": {\n          \"issueDate\": \"2026-04-15\",\n          \"dueDate\": \"2026-04-29\",\n          \"accountingDate\": \"2026-04-15\",\n          \"taxPointDate\": \"2026-04-15\",\n          \"vatObligationDate\": \"2026-04-15\"\n        },\n        \"currency\": \"CZK\",\n        \"exchangeRate\": null,\n        \"vat\": {\n          \"mode\": \"fromBase\",\n          \"place\": \"domestic\",\n          \"registrationCountry\": \"cz\"\n        },\n        \"payment\": {\n          \"method\": \"bankTransfer\",\n          \"paymentReference\": \"...\",\n          \"specificSymbol\": null,\n          \"constantSymbol\": null\n        },\n        \"notes\": {\n          \"internal\": null,\n          \"onDocument\": \"...\"\n        },\n        \"rows\": [\n          {\n            \"rowKind\": \"item\",\n            \"orderPos\": 1,\n            \"item\": {\n              \"supplierCode\": \"KONZ-001\",\n              \"name\": \"Konzultace\",\n              \"description\": \"Hodinová sazba\"\n            },\n            \"unit\": \"h\",\n            \"quantity\": 10,\n            \"unitPrice\": 1033.06,\n            \"totalPrice\": 10330.58,\n            \"priceCalcMode\": \"fromUnitPrice\",\n            \"discountPct\": null,\n            \"discountAmount\": null,\n            \"vat\": {\"code\": \"cz-110\", \"pct\": 21}\n          }\n        ],\n        \"vatRecap\": [\n          {\n            \"vatCode\": \"cz-110\", \"vatPct\": 21,\n            \"base\": 10330.58, \"tax\": 2169.42, \"total\": 12500.00,\n            \"isReversePair\": false\n          }\n        ],\n        \"totals\": {\n          \"totalBase\": 10330.58,\n          \"totalVat\": 2169.42,\n          \"totalAmount\": 12500.00,\n          \"totalRounding\": 0.00\n        },\n        \"attachments\": [\n          {\n            \"filename\": \"faktura-001.pdf\",\n            \"mimeType\": \"application/pdf\",\n            \"kind\": \"original\"\n          }\n        ]\n      }\n    }\n  ]\n}\n\nTop-level pole \"overall_confidence\" a \"documents\" JSOU VŽDY POVINNÁ, i když je documents prázdný seznam. Pokud žádný doklad neexistuje:\n\n{\"overall_confidence\": 1.0, \"documents\": []}\n\nNyní analyzuj přiložené dokumenty a vrať JSON.",
    "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
            "overall_confidence",
            "documents"
        ],
        "additionalProperties": false,
        "properties": {
            "overall_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            },
            "documents": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": [
                        "doc_type",
                        "source_attachment_ndxs",
                        "confidence",
                        "extracted_json"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "doc_type": {
                            "type": "string",
                            "enum": [
                                "invoiceReceived",
                                "invoiceIssued",
                                "creditNote",
                                "other"
                            ]
                        },
                        "source_attachment_ndxs": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "extracted_json": {
                            "$schema": "https://json-schema.org/draft/2020-12/schema",
                            "$id": "https://shipard.cz/schemas/shpd.docs.document.v1.json",
                            "title": "Shipard canonical document v1",
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "format",
                                "formatVersion",
                                "docType"
                            ],
                            "properties": {
                                "format": {
                                    "const": "shpd.docs.document"
                                },
                                "formatVersion": {
                                    "type": "string",
                                    "pattern": "^1\\.[0-9]+$"
                                },
                                "source": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "kind": {
                                            "type": "string"
                                        },
                                        "extractedAt": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time"
                                        },
                                        "confidence": {
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "minimum": 0,
                                            "maximum": 1
                                        },
                                        "mailMessage": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "extractedDoc": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "promptVersion": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "raw": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "additionalProperties": true
                                        }
                                    }
                                },
                                "docType": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "docNumber": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "docText": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "selfParty": {
                                    "enum": [
                                        "supplier",
                                        "customer",
                                        null
                                    ]
                                },
                                "supplier": {
                                    "$ref": "#/$defs/Party"
                                },
                                "customer": {
                                    "$ref": "#/$defs/Party"
                                },
                                "dates": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "issueDate": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "dueDate": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "accountingDate": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "taxPointDate": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "vatObligationDate": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "periodFrom": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "periodTo": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        }
                                    }
                                },
                                "currency": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "pattern": "^[A-Z]{3}$"
                                },
                                "exchangeRate": {
                                    "type": [
                                        "number",
                                        "null"
                                    ],
                                    "exclusiveMinimum": 0
                                },
                                "vat": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "mode": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "place": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "registrationCountry": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "pattern": "^[A-Za-z]{2}$"
                                        }
                                    }
                                },
                                "payment": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "method": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "paymentReference": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "maxLength": 35
                                        },
                                        "specificSymbol": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "constantSymbol": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    }
                                },
                                "notes": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "internal": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "onDocument": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    }
                                },
                                "rows": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/$defs/Row"
                                    }
                                },
                                "vatRecap": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/$defs/VatRecapEntry"
                                    }
                                },
                                "totals": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "totalBase": {
                                            "type": [
                                                "number",
                                                "null"
                                            ]
                                        },
                                        "totalVat": {
                                            "type": [
                                                "number",
                                                "null"
                                            ]
                                        },
                                        "totalAmount": {
                                            "type": [
                                                "number",
                                                "null"
                                            ]
                                        },
                                        "totalRounding": {
                                            "type": [
                                                "number",
                                                "null"
                                            ]
                                        }
                                    }
                                },
                                "attachments": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/$defs/Attachment"
                                    }
                                },
                                "_resolve": {
                                    "type": "object",
                                    "additionalProperties": true
                                },
                                "applyOptions": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "targetDocState": {
                                            "type": "integer",
                                            "enum": [
                                                10,
                                                20
                                            ]
                                        },
                                        "autoCreateMode": {
                                            "enum": [
                                                "strict",
                                                "safe",
                                                "liberal"
                                            ]
                                        },
                                        "createMissingEntities": {
                                            "type": "boolean"
                                        },
                                        "rejectOnIssues": {
                                            "type": "array",
                                            "items": {
                                                "enum": [
                                                    "error",
                                                    "warning"
                                                ]
                                            }
                                        },
                                        "importNumber": {
                                            "type": "object",
                                            "description": "Import mode: force the document's own number + sequence instead of generating from the series counter. Used by legacy migration. When present, DocDocument skips assignDocumentNumber and syncs the counter to GREATEST(last_assigned, sequenceNumber).",
                                            "properties": {
                                                "docNumber": {
                                                    "type": "string",
                                                    "minLength": 1,
                                                    "description": "The document's own number to store verbatim in doc_number."
                                                },
                                                "sequenceNumber": {
                                                    "type": "integer",
                                                    "minimum": 1,
                                                    "description": "Sequence-in-series, used for counter sync and payment_reference default."
                                                }
                                            },
                                            "required": [
                                                "docNumber",
                                                "sequenceNumber"
                                            ],
                                            "additionalProperties": false
                                        },
                                        "importOwnBankAccount": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ],
                                            "minimum": 1,
                                            "description": "Import mode: id of our own bank account (economy_codebooks_bank_accounts) to set on the document. For issued invoices confirmed at state 20+, bank_account is required and cannot be carried by the standard self-party flow; the importer resolves it and passes it here."
                                        }
                                    }
                                },
                                "savedDocId": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ]
                                }
                            },
                            "$defs": {
                                "Party": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "name": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
