                                                "null"
                                            ]
                                        },
                                        "bic": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "currency": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "pattern": "^[A-Z]{3}$"
                                        }
                                    }
                                },
