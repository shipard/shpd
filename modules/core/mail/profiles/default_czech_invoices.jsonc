                                        "isReversePair": {
                                            "type": [
                                                "boolean",
                                                "null"
                                            ]
                                        }
                                    }
                                },
                                "Attachment": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "filename": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "mimeType": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "size": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ],
                                            "minimum": 0
                                        },
                                        "sha256": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "pattern": "^[a-fA-F0-9]{64}$"
                                        },
                                        "kind": {
                                            "enum": [
                                                "original",
                                                "scan",
                                                "supplement",
                                                "preview",
                                                null
                                            ]
                                        },
                                        "ref": {
                                            "type": [
