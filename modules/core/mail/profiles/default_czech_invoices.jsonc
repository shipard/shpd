                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "email": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "phone": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "web": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    }
                                },
                                "BankAccount": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "accountNumber": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
