                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "address": {
                                            "$ref": "#/$defs/Address"
                                        },
                                        "contact": {
                                            "$ref": "#/$defs/Contact"
                                        },
                                        "bankAccount": {
                                            "$ref": "#/$defs/BankAccount"
                                        },
                                        "paymentTermDays": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ],
                                            "minimum": 0
                                        }
                                    }
                                },
                                "Address": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "street": {
