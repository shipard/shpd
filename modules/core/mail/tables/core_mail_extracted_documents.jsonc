{
    "tableId": 306,
    "name": "Extracted documents",
    "name:cs": "Extrahované dokumenty",
    "name:en": "Extracted documents",

    "displayPattern": "{doc_type} — {confidence}",

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "extraction",
            "name": "Extraction",
            "name:cs": "Extrakce",
            "name:en": "Extraction"
        },
        {
            "id": "review",
            "name": "Review",
            "name:cs": "Kontrola",
            "name:en": "Review"
        },
        {
            "id": "target",
            "name": "Target entity",
            "name:cs": "Cílová entita",
            "name:en": "Target entity"
        },
        {
            "id": "lineage",
            "name": "Lineage",
            "name:cs": "Návaznosti",
            "name:en": "Lineage"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "message",
            "name": "Message",
            "name:cs": "Zpráva",
            "name:en": "Message",
            "type": "int",
            "nullable": false,
            "reference": "core_mail_incoming_messages",
            "group": "identity"
        },
        {
            "id": "analysis",
            "name": "Analysis run",
            "name:cs": "Běh analýzy",
            "name:en": "Analysis run",
            "type": "int",
            "nullable": false,
            "reference": "core_mail_message_analyses",
            "group": "identity"
        },
        {
            "id": "doc_type",
            "name": "Document type",
            "name:cs": "Typ dokumentu",
            "name:en": "Document type",
            "type": "enumString",
            "length": 30,
            "nullable": false,
            "cfgItem": "core.mail.extractedDocTypes",
            "group": "identity"
        },

        // --- extraction ---

        {
            "id": "source_attachments",
            "name": "Source attachments",
            "name:cs": "Zdrojové přílohy",
            "name:en": "Source attachments",
            "type": "text",
            "nullable": true,
            "group": "extraction"
        },
        {
            "id": "extracted_json",
            "name": "Extracted JSON",
            "name:cs": "Extrahovaná data (JSON)",
            "name:en": "Extracted JSON",
            "type": "longtext",
            "nullable": true,
            "group": "extraction"
        },
        {
            "id": "confidence",
            "name": "Confidence",
            "name:cs": "Jistota",
            "name:en": "Confidence",
            "type": "numeric",
            "precision": 4,
            "scale": 3,
            "nullable": true,
            "group": "extraction"
        },

        // --- review ---

        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status",
            "type": "enumInt",
            "default": 20,
            "nullable": false,
            "cfgItem": "core.mail.extractedDocStates",
            "group": "review"
        },
        {
            "id": "rejected_reason",
            "name": "Rejected reason",
            "name:cs": "Důvod zamítnutí",
            "name:en": "Rejected reason",
            "type": "text",
            "nullable": true,
            "group": "review"
        },

        // --- target ---

        {
            "id": "target_table_id",
            "name": "Target table",
            "name:cs": "Cílová tabulka",
            "name:en": "Target table",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "target"
        },
        {
            "id": "target_row_ndx",
            "name": "Target record",
            "name:cs": "Cílový záznam",
            "name:en": "Target record",
            "type": "int",
            "nullable": true,
            "group": "target"
        },
        {
            "id": "applied_at",
            "name": "Applied at",
            "name:cs": "Použito",
            "name:en": "Applied at",
            "type": "datetime",
            "nullable": true,
            "group": "target"
        },
        {
            "id": "applied_by",
            "name": "Applied by",
            "name:cs": "Použil",
            "name:en": "Applied by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "target"
        },

        // --- lineage ---

        {
            "id": "superseded_by",
            "name": "Superseded by",
            "name:cs": "Nahrazeno čím",
            "name:en": "Superseded by",
            "type": "int",
            "nullable": true,
            "reference": "core_mail_extracted_documents",
            "group": "lineage"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        }
    ],

    "indexes": [
        {
            "id": "idx_message",
            "type": "index",
            "columns": [
                {"column": "message"}
            ]
        },
        {
            "id": "idx_analysis",
            "type": "index",
            "columns": [
                {"column": "analysis"}
            ]
        },
        {
            "id": "idx_status",
            "type": "index",
            "columns": [
                {"column": "status"}
            ]
        },
        {
            "id": "idx_message_status",
            "type": "index",
            "columns": [
                {"column": "message"},
                {"column": "status"}
            ]
        }
    ]
}
