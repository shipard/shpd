{
    "tableId": 302,
    "name": "Mailboxes",
    "name:cs": "Schránky",
    "name:en": "Mailboxes",

    "displayPattern": "{mailbox_id} — {name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "config",
            "name": "Configuration",
            "name:cs": "Konfigurace",
            "name:en": "Configuration"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "mailbox_id",
            "name": "Mailbox code",
            "name:cs": "Kód schránky",
            "name:en": "Mailbox code",
            "type": "varchar",
            "length": 50,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 100,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "email_address",
            "name": "E-mail address",
            "name:cs": "E-mailová adresa",
            "name:en": "E-mail address",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "description",
            "name": "Description",
            "name:cs": "Popis",
            "name:en": "Description",
            "type": "text",
            "nullable": true,
            "group": "identity"
        },

        // --- configuration ---

        {
            "id": "default_primary_type",
            "name": "Default primary type",
            "name:cs": "Výchozí primární typ",
            "name:en": "Default primary type",
            "type": "enumString",
            "length": 30,
            "nullable": true,
            "cfgItem": "core.mail.primaryTypes",
            "group": "config"
        },
        {
            "id": "is_default",
            "name": "Default mailbox",
            "name:cs": "Výchozí schránka",
            "name:en": "Default mailbox",
            "type": "boolean",
            "default": 0,
            "group": "config"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        },
        {
            "id": "modified",
            "name": "Modified",
            "name:cs": "Změněno",
            "name:en": "Modified",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_mailbox_id",
            "type": "unique",
            "columns": [
                {"column": "mailbox_id"}
            ]
        },
        {
            "id": "unq_email_address",
            "type": "unique",
            "columns": [
                {"column": "email_address"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "name", "order": "ASC"}
            ]
        },
        {
            "id": "idx_is_default",
            "type": "index",
            "columns": [
                {"column": "is_default"}
            ]
        }
    ]
}
