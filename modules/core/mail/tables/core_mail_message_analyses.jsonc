{
    "tableId": 304,
    "name": "Message analyses",
    "name:cs": "Analýzy zpráv",
    "name:en": "Message analyses",

    "displayPattern": "{analyzed_at} — {model_name}",

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "model",
            "name": "Model",
            "name:cs": "Model",
            "name:en": "Model"
        },
        {
            "id": "result",
            "name": "Result",
            "name:cs": "Výsledek",
            "name:en": "Result"
        },
        {
            "id": "resolution",
            "name": "Resolution",
            "name:cs": "Verdikt",
            "name:en": "Resolution"
        },
        {
            "id": "telemetry",
            "name": "Telemetry",
            "name:cs": "Telemetrie",
            "name:en": "Telemetry"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "message",
            "name": "Message",
            "name:cs": "Zpráva",
            "name:en": "Message",
            "type": "int",
            "nullable": false,
            "reference": "core_mail_incoming_messages",
            "group": "identity"
        },
        {
            "id": "profile",
            "name": "Profile",
            "name:cs": "Profil",
            "name:en": "Profile",
            "type": "int",
            "nullable": true,
            "reference": "core_mail_ai_profiles",
            "group": "identity"
        },
        {
            "id": "backend",
            "name": "Backend",
            "name:cs": "Backend",
            "name:en": "Backend",
            "type": "int",
            "nullable": true,
            "reference": "core_ai_backends",
            "group": "identity"
        },
        {
            "id": "analyzed_at",
            "name": "Analyzed at",
            "name:cs": "Čas analýzy",
            "name:en": "Analyzed at",
            "type": "datetime",
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav analýzy",
            "name:en": "Status",
            "type": "tinyint",
            "default": 1,
            "nullable": false,
            "group": "identity"
        },

        // --- model ---

        {
            "id": "model_name",
            "name": "Model name",
            "name:cs": "Název modelu",
            "name:en": "Model name",
            "type": "varchar",
            "length": 100,
            "nullable": false,
            "group": "model"
        },
        {
            "id": "model_version",
            "name": "Model version",
            "name:cs": "Verze modelu",
            "name:en": "Model version",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "model"
        },
        {
            "id": "prompt_version",
            "name": "Prompt version",
            "name:cs": "Verze promptu",
            "name:en": "Prompt version",
            "type": "varchar",
            "length": 50,
            "nullable": false,
            "group": "model"
        },

        // --- result ---

        {
            "id": "analysis_json",
            "name": "Analysis result (JSON)",
            "name:cs": "Výsledek analýzy (JSON)",
            "name:en": "Analysis result (JSON)",
            "type": "longtext",
            "nullable": true,
            "group": "result"
        },
        {
            "id": "confidence",
            "name": "Confidence",
            "name:cs": "Jistota",
            "name:en": "Confidence",
            "type": "numeric",
            "precision": 4,
            "scale": 3,
            "nullable": true,
            "group": "result"
        },
        {
            // Validovaný + obohacený canonical návrhu dokumentu
            // (shpd.docs.document.v1, resp. shpd.registry.document.v1).
            // NULL = běh žádný dokument nenavrhl. Při selhání validace
            // wrapper {_validationError, _validationIssues, _rawOutput}.
            "id": "canonical_json",
            "name": "Proposed document (JSON)",
            "name:cs": "Návrh dokumentu (JSON)",
            "name:en": "Proposed document (JSON)",
            "type": "longtext",
            "nullable": true,
            "group": "result"
        },
        {
            // Typ dokumentu navržený tímto během (klíč core.mail.primaryTypes).
            // Historický záznam — na rozdíl od mutable message.primary_type se
            // po zápisu nemění. Ve wire kontraktu se pole jmenuje doc_type.
            "id": "proposed_type",
            "name": "Proposed type",
            "name:cs": "Navržený typ",
            "name:en": "Proposed type",
            "type": "enumString",
            "length": 30,
            "cfgItem": "core.mail.primaryTypes",
            "nullable": true,
            "group": "result"
        },
        {
            // Obsahový štítek dokladu z obsahové eskalace párování
            // (tasks/content-tag-enrichment.md) — denormalizace
            // `_resolve.contentTag.tag` z canonical_json. Zdroj štítku
            // (rule/llm) nese jen audit blok v canonicalu.
            "id": "content_tag",
            "name": "Content tag",
            "name:cs": "Obsahový štítek",
            "name:en": "Content tag",
            "type": "enumString",
            "length": 40,
            "cfgItem": "core.exchange.contentTags",
            "nullable": true,
            "group": "result"
        },
        {
            "id": "error_message",
            "name": "Error message",
            "name:cs": "Chybová zpráva",
            "name:en": "Error message",
            "type": "text",
            "nullable": true,
            "group": "result"
        },

        // --- resolution ---

        {
            // NULL = otevřený návrh / bez návrhu, 40 = applied, 50 = rejected.
            "id": "resolution",
            "name": "Resolution",
            "name:cs": "Verdikt",
            "name:en": "Resolution",
            "type": "enumInt",
            "cfgItem": "core.mail.analysisResolutions",
            "nullable": true,
            "group": "resolution"
        },
        {
            // Povinný při resolution = 50 (rejected).
            "id": "rejected_reason",
            "name": "Rejected reason",
            "name:cs": "Důvod zamítnutí",
            "name:en": "Rejected reason",
            "type": "text",
            "nullable": true,
            "group": "resolution"
        },
        {
            "id": "resolved_at",
            "name": "Resolved at",
            "name:cs": "Čas verdiktu",
            "name:en": "Resolved at",
            "type": "datetime",
            "nullable": true,
            "group": "resolution"
        },
        {
            "id": "resolved_by",
            "name": "Resolved by",
            "name:cs": "Rozhodl",
            "name:en": "Resolved by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "resolution"
        },

        // --- telemetry ---

        {
            "id": "tokens_input",
            "name": "Tokens in",
            "name:cs": "Tokenů vstup",
            "name:en": "Tokens in",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "tokens_output",
            "name": "Tokens out",
            "name:cs": "Tokenů výstup",
            "name:en": "Tokens out",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "duration_ms",
            "name": "Duration (ms)",
            "name:cs": "Trvání (ms)",
            "name:en": "Duration (ms)",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "cost_usd",
            "name": "Cost (USD)",
            "name:cs": "Cena (USD)",
            "name:en": "Cost (USD)",
            "type": "numeric",
            "precision": 10,
            "scale": 6,
            "nullable": true,
            "group": "telemetry"
        },
        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        }
    ],

    "indexes": [
        {
            "id": "idx_message",
            "type": "index",
            "columns": [
                {"column": "message"}
            ]
        },
        {
            "id": "idx_message_analyzed",
            "type": "index",
            "columns": [
                {"column": "message"},
                {"column": "analyzed_at", "order": "DESC"}
            ]
        },
        {
            "id": "idx_content_tag",
            "type": "index",
            "columns": [
                {"column": "content_tag"}
            ]
        }
    ]
}
