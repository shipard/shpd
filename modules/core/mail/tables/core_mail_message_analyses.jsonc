{
    "tableId": 304,
    "name": "Message analyses",
    "name:cs": "Analýzy zpráv",
    "name:en": "Message analyses",

    "displayPattern": "{analyzed_at} — {model_name}",

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "model",
            "name": "Model",
            "name:cs": "Model",
            "name:en": "Model"
        },
        {
            "id": "result",
            "name": "Result",
            "name:cs": "Výsledek",
            "name:en": "Result"
        },
        {
            "id": "telemetry",
            "name": "Telemetry",
            "name:cs": "Telemetrie",
            "name:en": "Telemetry"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "message",
            "name": "Message",
            "name:cs": "Zpráva",
            "name:en": "Message",
            "type": "int",
            "nullable": false,
            "reference": "core_mail_incoming_messages",
            "group": "identity"
        },
        {
            "id": "analyzed_at",
            "name": "Analyzed at",
            "name:cs": "Čas analýzy",
            "name:en": "Analyzed at",
            "type": "datetime",
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav analýzy",
            "name:en": "Status",
            "type": "tinyint",
            "default": 1,
            "nullable": false,
            "group": "identity"
        },

        // --- model ---

        {
            "id": "model_name",
            "name": "Model name",
            "name:cs": "Název modelu",
            "name:en": "Model name",
            "type": "varchar",
            "length": 100,
            "nullable": false,
            "group": "model"
        },
        {
            "id": "model_version",
            "name": "Model version",
            "name:cs": "Verze modelu",
            "name:en": "Model version",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "model"
        },
        {
            "id": "prompt_version",
            "name": "Prompt version",
            "name:cs": "Verze promptu",
            "name:en": "Prompt version",
            "type": "varchar",
            "length": 50,
            "nullable": false,
            "group": "model"
        },

        // --- result ---

        {
            "id": "analysis_json",
            "name": "Analysis result (JSON)",
            "name:cs": "Výsledek analýzy (JSON)",
            "name:en": "Analysis result (JSON)",
            "type": "longtext",
            "nullable": true,
            "group": "result"
        },
        {
            "id": "confidence",
            "name": "Confidence",
            "name:cs": "Jistota",
            "name:en": "Confidence",
            "type": "numeric",
            "precision": 4,
            "scale": 3,
            "nullable": true,
            "group": "result"
        },
        {
            "id": "error_message",
            "name": "Error message",
            "name:cs": "Chybová zpráva",
            "name:en": "Error message",
            "type": "text",
            "nullable": true,
            "group": "result"
        },

        // --- telemetry ---

        {
            "id": "tokens_input",
            "name": "Tokens in",
            "name:cs": "Tokenů vstup",
            "name:en": "Tokens in",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "tokens_output",
            "name": "Tokens out",
            "name:cs": "Tokenů výstup",
            "name:en": "Tokens out",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },
        {
            "id": "duration_ms",
            "name": "Duration (ms)",
            "name:cs": "Trvání (ms)",
            "name:en": "Duration (ms)",
            "type": "int",
            "nullable": true,
            "group": "telemetry"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        }
    ],

    "indexes": [
        {
            "id": "idx_message",
            "type": "index",
            "columns": [
                {"column": "message"}
            ]
        },
        {
            "id": "idx_message_analyzed",
            "type": "index",
            "columns": [
                {"column": "message"},
                {"column": "analyzed_at", "order": "DESC"}
            ]
        }
    ]
}
