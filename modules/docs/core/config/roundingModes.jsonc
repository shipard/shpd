{
    // docs.core.roundingModes — zaokrouhlení celkové částky dokladu
    // (`total_rounding_mode`).
    //
    // Autorita sémantiky kódů (krok, směr) je PHP třída
    // `modules/docs/core/src/RoundingModes.php`; tady jsou jen názvy pro UI.
    // Test RoundingModesTest hlídá shodu množiny kódů.
    //
    //   0 = na haléře (0,01) — dřívější 2 „matematicky na 0,01“ bylo totožné,
    //       ds-upgrade slévá 2 → 0 (#63)
    //   1 = matematicky na 1 (celé Kč)
    //   3 = nahoru na 1 (ceil)
    //   4 = dolů na 1 (floor)
    //   5 = matematicky na 0,05 (hotovost SK, FI, NL, BE, IE, IT, EE, LT)

    "0": {
        "name": "On cents (0.01)",
        "name:cs": "Na haléře (0,01)",
        "name:en": "On cents (0.01)"
    },
    "1": {
        "name": "Round to 1",
        "name:cs": "Matematicky na 1",
        "name:en": "Round to 1"
    },
    "3": {
        "name": "Round up to 1",
        "name:cs": "Nahoru na 1",
        "name:en": "Round up to 1"
    },
    "4": {
        "name": "Round down to 1",
        "name:cs": "Dolů na 1",
        "name:en": "Round down to 1"
    },
    "5": {
        "name": "Round to 0.05",
        "name:cs": "Matematicky na 0,05",
        "name:en": "Round to 0.05"
    }
}
