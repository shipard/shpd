        "name:cs": "Nákup zboží a materiálu",
        "name:en": "Purchase of goods",
        "docTypes": {
            "invni": {"order": 100}
        }
    },
    "purchase.services": {
        "name": "Purchase of services",
        "name:cs": "Nákup služeb",
        "name:en": "Purchase of services",
        "docTypes": {
            "invni": {"order": 200}
        }
    },
    "purchase.other": {
        "name": "Other purchase",
        "name:cs": "Ostatní nákup",
        "name:en": "Other purchase",
        "docTypes": {
            "invni": {"order": 300}
        }
    },

    // Zálohy a majetek (vlna C): zálohové operace NEMAJÍ rowAccount —
    // účet dohledávají kategorie advances.* účtovacího předpisu maskou
    // nad rozvrhem DS (D10, vzor saldokontních zápočtů), formulář vstup
    // účtu nezobrazí. Majetek má přímý účet na řádku (analytika per druh
    // majetku, D9). rowPaymentId na zálohových operacích —
    // payment_reference řádku nese číslo zálohového dokladu (staré symbol1),
    // na které naváže saldokontní párování záloh (Fáze 4+). Odpočty jsou na
    // dokladu záporné (věrný obraz), stranu otáčí reverseSign v předpisu.
    "purchase.advanceDeduction": {
        "name": "Advance payment deduction",
        "name:cs": "Odpočet poskytnuté zálohy",
        "name:en": "Advance payment deduction",
        "rowPaymentId": 1,
        "docTypes": {
            "invni": {"order": 400}
        }
    },
    "purchase.advanceVat": {
        "name": "Advance payment taxation",
