{
    // docs.core.rowOperations
    //
    // Pohyby řádků dokladů. Klíč = stabilní stringový identifikátor.
    // docTypes: pro které typy dokladů je pohyb povolený; order určuje
    // pořadí v nabídce UI (vzestupně, první = default pro nový řádek).
    //
    // Vlajky per-řádkové identity (čte je AccountingEngine ve Fázi 2):
    //   rowPartner: 1   — řádek nese vlastního partnera (engine ho razítkuje
    //                     z řádku místo z hlavičky; formulář ukáže input).
    //   rowPaymentId: 1 — řádek nese vlastní platební identitu
    //                     (payment_reference / specific_symbol /
    //                     constant_symbol / due_date), jinak z hlavičky.
    //
    // Forma-facing atributy (řídí vstupy formuláře — protějšky accountSrc /
    // sideSrc z účtovacího předpisu, musí souhlasit):
    //   rowAccount: "direct" — účet se zadává přímo na řádku (vstup account)
    //   rowAccount: "item"   — účet přijde z položky typu 2 (vstup item)
    //   rowSide: 1           — strana MD/DAL se zadává na řádku (vstup
    //                          acc_side; protějšek sideSrc: "row" předpisu).
    //                          Přepíná formulář do kontačního layoutu bez
    //                          položkového bloku (množství/cena/DPH).
    //   rowSide: 0           — kontační layout, ale BEZ volby strany: stranu
    //                          nesou fixní kroky předpisu (side na kroku),
    //                          částky řádků kladné — směr = volba operace
    //                          (kurzové rozdíly). Vlajka chybí = položkový
    //                          layout.
    //   selfBalancing: 1     — kroky předpisu pokrývají OBĚ strany (jeden
    //                          řádek → MD i DAL stejnou částkou, FX čtveřice).
    //                          Kontrola vyrovnanosti (AccountingDocument)
    //                          počítá řádek do MD i DAL a acc_side ignoruje;
    //                          součty ho počítají jednou do Σ MD. Parita
    //                          vlajky s kroky předpisu je hlídaná testem.
    //
    // Operace s rowAccount/rowPartner/rowPaymentId bez rowSide (zálohy,
    // majetek na fakturách) zůstávají v položkovém layoutu — jen dostanou
    // navíc vstup účtu a/nebo pole saldo identity; stranu určuje krok
    // předpisu. Saldokontní operace (zápočty) mají rowPartner/rowPaymentId,
    // ale žádný rowAccount — účet je implicitní z kategorie účtovacího
    // předpisu (resolveCategoryAccount, ekvivalent starého acc-default.json);
    // formulář proto vstup účtu/položky nezobrazí.

    "sale.services": {
        "name": "Sale of services",
        "name:cs": "Prodej služeb",
        "name:en": "Sale of services",
        "docTypes": {
            "invno": {"order": 100}
        }
    },
    "sale.goods": {
        "name": "Sale of goods",
        "name:cs": "Prodej zboží",
        "name:en": "Sale of goods",
        "docTypes": {
            "invno": {"order": 200}
        }
    },
    "purchase.goods": {
