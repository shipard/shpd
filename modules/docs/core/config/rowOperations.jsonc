        }
    },
    "sale.advanceVat": {
        "name": "Advance payment taxation",
        "name:cs": "Zdanění přijaté zálohy",
        "name:en": "Advance payment taxation",
        "rowPaymentId": 1,
        "docTypes": {
            "invno": {"order": 400}
        }
    },
