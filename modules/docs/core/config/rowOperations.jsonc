{
    // docs.core.rowOperations
    //
    // Pohyby řádků dokladů. Klíč = stabilní stringový identifikátor.
    // docTypes: pro které typy dokladů je pohyb povolený; order určuje
    // pořadí v nabídce UI (vzestupně, první = default pro nový řádek).
    //
    // Vlajky per-řádkové identity (čte je AccountingEngine ve Fázi 2):
    //   rowPartner: 1   — řádek nese vlastního partnera (engine ho razítkuje
    //                     z řádku místo z hlavičky; formulář ukáže input).
    //   rowPaymentId: 1 — řádek nese vlastní platební identitu
    //                     (payment_reference / specific_symbol /
    //                     constant_symbol / due_date), jinak z hlavičky.
    //
    // Forma-facing atribut (řídí, jaký vstup účtu formulář ukáže — protějšek
    // accountSrc z účtovacího předpisu, musí souhlasit):
    //   rowAccount: "direct" — účet se zadává přímo na řádku (vstup account)
    //   rowAccount: "item"   — účet přijde z položky typu 2 (vstup item)
    //
    // Kontační řádek = operace má rowAccount NEBO rowPartner NEBO rowPaymentId.
    // Saldokontní operace (zápočty) mají rowPartner/rowPaymentId, ale žádný
    // rowAccount — účet je implicitní z kategorie účtovacího předpisu
    // (resolveCategoryAccount, ekvivalent starého acc-default.json); formulář
    // proto vstup účtu/položky nezobrazí.

    "sale.services": {
        "name": "Sale of services",
        "name:cs": "Prodej služeb",
        "name:en": "Sale of services",
        "docTypes": {
            "invno": {"order": 100}
        }
    },
    "sale.goods": {
        "name": "Sale of goods",
        "name:cs": "Prodej zboží",
        "name:en": "Sale of goods",
        "docTypes": {
            "invno": {"order": 200}
        }
    },
    "purchase.goods": {
        "name": "Purchase of goods",
        "name:cs": "Nákup zboží a materiálu",
        "name:en": "Purchase of goods",
        "docTypes": {
            "invni": {"order": 100}
        }
    },
    "purchase.services": {
        "name": "Purchase of services",
        "name:cs": "Nákup služeb",
        "name:en": "Purchase of services",
        "docTypes": {
            "invni": {"order": 200}
        }
    },
    "purchase.other": {
        "name": "Other purchase",
        "name:cs": "Ostatní nákup",
        "name:en": "Other purchase",
        "docTypes": {
            "invni": {"order": 300}
        }
    },
    "acc.entry": {
        "name": "Accounting entry",
        "name:cs": "Účetní položka",
        "name:en": "Accounting entry",
        "docTypes": {
            "invno": {"order": 900},
            "invni": {"order": 900}
        }
    },
    "acc.record": {
        "name": "Accounting record",
        "name:cs": "Účetní zápis",
        "name:en": "Accounting record",
        "rowPartner": 1,
        "rowPaymentId": 1,
        "rowAccount": "direct",
        "docTypes": { "cmnbkp": {"order": 100} }
    },
    "acc.item": {
        "name": "Accounting item",
        "name:cs": "Účetní položka",
        "name:en": "Accounting item",
        "rowPartner": 1,
        "rowPaymentId": 1,
        "rowAccount": "item",
        "docTypes": { "cmnbkp": {"order": 200} }
    },
    "acc.balanceReceivable": {
        "name": "Receivable set-off",
        "name:cs": "Zápočet pohledávky",
        "name:en": "Receivable set-off",
        "rowPartner": 1,
        "rowPaymentId": 1,
        "docTypes": { "cmnbkp": {"order": 300} }
    },
    "acc.balancePayable": {
        "name": "Payable set-off",
        "name:cs": "Zápočet závazku",
        "name:en": "Payable set-off",
        "rowPartner": 1,
        "rowPaymentId": 1,
        "docTypes": { "cmnbkp": {"order": 400} }
    }
}
