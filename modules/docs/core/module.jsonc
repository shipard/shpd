{
    "id": "docs.core",
    "name": "Document core",
    "name:cs": "Doklady — jádro",
    "name:en": "Document core",
    "description": "Polymorphic core for all document types (invoices, …)",
    "description:cs": "Polymorfní jádro pro všechny typy dokladů (faktury, …)",
    "description:en": "Polymorphic core for all document types (invoices, …)",

    "dependencies": [
        "core.system",
        "core.alerts",
        "core.units",
        "core.attachments",
        "base.persons",
        "world.base",
        "world.vat",
        "economy.codebooks",
        "economy.items"
    ],

    "tables": [
        "docs_core_heads",
        "docs_core_rows",
        "docs_core_vat_recap",
        "docs_core_number_series",
        "docs_core_number_counters"
    ],

    "extensions": [
        "base_persons_persons"
    ],

    "settingsItems": [
        { "viewer": "docs.core.numberSeries", "section": "accounting" }
    ],

    "viewers": [
        {
            "id": "docs.core.numberSeries",
            "name": "Document number series",
            "name:cs": "Číselné řady dokladů",
            "name:en": "Document number series",
            "icon": "hash",
            "table": "docs_core_number_series",
            "class": "Shipard\\Module\\Docs\\Core\\NumberSeriesViewer"
        },
        {
            "id": "docs.core.heads",
            "name": "Documents",
            "name:cs": "Doklady",
            "name:en": "Documents",
            "icon": "document",
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Docs\\Core\\DocsHeadsViewer"
        }
    ],

    "forms": [
        {
            "table": "docs_core_number_series",
            "class": "Shipard\\Module\\Docs\\Core\\NumberSeriesForm"
        },
        {
            // Polymorphic dispatch by `doc_type` column. The `classes` map is
            // populated by per-type modules (docs.invoicesOut, docs.invoicesIn)
            // via FormLoader::mergeForms. Unknown / empty doc_type falls back
            // to defaultClass — same pattern as documentClasses polymorphism.
            "table": "docs_core_heads",
            "typeColumn": "doc_type",
            "defaultClass": "Shipard\\Module\\Docs\\Core\\DocsHeadsForm"
        },
        {
            "table": "docs_core_rows",
            "id": "docs.core.rows",
            "class": "Shipard\\Module\\Docs\\Core\\DocRowsForm"
        }
    ],

    "documentClasses": [
        {
            "table": "docs_core_number_series",
            "class": "Shipard\\Module\\Docs\\Core\\NumberSeriesDocument"
        },
        {
            // Polymorphic dispatch by `doc_type` column. The `classes` map is
            // populated by per-type modules (docs.invoicesOut, docs.invoicesIn)
            // via DocumentLoader::mergeDocumentClasses. Unknown / empty doc_type
            // falls back to defaultClass.
            "table": "docs_core_heads",
            "typeColumn": "doc_type",
            "defaultClass": "Shipard\\Module\\Docs\\Core\\DocsHeadsDocument"
        },
        {
            // DocRowsDocument has no own validate / beforeSave — the only
            // reason it exists is the afterSave hook that recomputes header
            // totals + VAT recap whenever a row is added, edited, or deleted.
            "table": "docs_core_rows",
            "class": "Shipard\\Module\\Docs\\Core\\DocRowsDocument"
        }
    ],

    "config": [
        { "id": "docs.core.docTypes",        "file": "config/docTypes.jsonc" },
        { "id": "docs.core.docStates",       "file": "config/docStates.jsonc" },
        { "id": "docs.core.vatModes",        "file": "config/vatModes.jsonc" },
        { "id": "docs.core.vatCalcSources",  "file": "config/vatCalcSources.jsonc" },
        { "id": "docs.core.vatPlaces",       "file": "config/vatPlaces.jsonc" },
        { "id": "docs.core.priceCalcModes",  "file": "config/priceCalcModes.jsonc" },
        { "id": "docs.core.rowKinds",        "file": "config/rowKinds.jsonc" },
        { "id": "docs.core.rowOperations",   "file": "config/rowOperations.jsonc" },
        { "id": "docs.core.roundingModes",   "file": "config/roundingModes.jsonc" },
        { "id": "docs.core.paymentMethods",  "file": "config/paymentMethods.jsonc" },
        { "id": "docs.core.resetScopes",     "file": "config/resetScopes.jsonc" },
        { "id": "docs.core.sourceKinds",     "file": "config/sourceKinds.jsonc" }
    ],

    "alertChecks": [
        {
            "id": "docs.core.stale_in_repair",
            "name": "Documents stale in repair (>24 h)",
            "name:cs": "Doklady v opravě déle než 24 h",
            "name:en": "Documents stale in repair (>24 h)",
            "description": "Detects documents stuck in 'Being edited' state for more than 24 hours.",
            "description:cs": "Detekuje doklady visící ve stavu „V opravě\" déle než 24 hodin.",
            "description:en": "Detects documents stuck in 'Being edited' state for more than 24 hours.",
            "class": "Shipard\\Module\\Docs\\Core\\Checks\\StaleInRepairCheck",
            "severity": "warning",
            "interval": "1h",
            "tags": ["docs", "stale"]
        }
    ]
}
