                                {"type": "select", "column": "amounts_sign", "required": true},
                                {"type": "select", "column": "bal_side", "required": true},
                                {"type": "input", "column": "modify_sign"},
                                {"type": "input", "column": "note"},
                                {"type": "input", "column": "sort_order"},
                                {"type": "input", "column": "valid_from"},
                                {"type": "input", "column": "valid_to"}
                            ]
                        }
                    ]
                }
            ]
