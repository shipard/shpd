{
    "tableId": 419,
    "name": "Balance allocations",
    "name:cs": "Párovací vazby saldokont",
    "name:en": "Balance allocations",

    // Párovací vazby úhrada↔předpis. Ve Fázi 2b se zakládá PRÁZDNÁ —
    // plní ji matcher ve Fázi 3. Reziduum předpisu = amount − Σ allocations.
    // Bez docStates/formu (derivát párování).

    "displayPattern": "{id}",

    "columns": [
        {"id": "id", "name": "ID", "type": "int", "autoIncrement": true, "primaryKey": true},

        {"id": "payment_entry", "name": "Payment entry", "name:cs": "Úhrada", "name:en": "Payment entry",
            "type": "int", "nullable": false, "reference": "economy_accbal_ledger"},
        {"id": "request_entry", "name": "Request entry", "name:cs": "Předpis", "name:en": "Request entry",
            "type": "int", "nullable": false, "reference": "economy_accbal_ledger"},

        {"id": "amount", "name": "Amount", "name:cs": "Částka (měna dokladu)", "name:en": "Amount",
            "type": "numeric", "precision": 15, "scale": 2, "default": 0},
        {"id": "amount_hc", "name": "Amount (home currency)", "name:cs": "Částka (domácí měna)", "name:en": "Amount (home currency)",
            "type": "numeric", "precision": 15, "scale": 2, "default": 0},

        {"id": "created_by", "name": "Created by", "name:cs": "Vznik", "name:en": "Created by",
            "type": "enumInt", "cfgItem": "economy.accbal.allocationOrigins", "default": 0, "nullable": false},
        {"id": "note", "name": "Note", "name:cs": "Poznámka", "name:en": "Note",
            "type": "varchar", "length": 200, "nullable": true}
    ],

    "indexes": [
        {"id": "idx_request_entry", "type": "index", "columns": [{"column": "request_entry"}]},
        {"id": "idx_payment_entry", "type": "index", "columns": [{"column": "payment_entry"}]}
    ]
}
