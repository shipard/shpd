    // sloupec economy.items. Závislost směřuje správně: účetnictví zná
    // položky, položky o účetnictví nevědí.

    "table": "economy_items",
    "columns": [
        {
            "id": "accounting_account",
            "name": "Accounting account",
            "name:cs": "Účet",
            "name:en": "Accounting account",
            "type": "int",
            "nullable": true,
            "reference": "economy_accounting_accounts",
            "group": "classification"
        }
    ]
}
