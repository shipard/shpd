{
    "id": "economy.accounting",
    "name": "Accounting",
    "name:cs": "Účetnictví",
    "name:en": "Accounting",
    "description": "Double-entry accounting — chart of accounts",
    "description:cs": "Podvojné účetnictví — účtový rozvrh",
    "description:en": "Double-entry accounting — chart of accounts",

    "dependencies": ["core.system", "economy.items", "docs.core"],

    "tables": [
        "economy_accounting_accounts",
        "economy_accounting_journal"
    ],

    "extensions": [
        "economy_items",
        "docs_core_heads"
    ],

    "viewers": [
        {
            "id": "economy.accounting.accounts",
            "name": "Chart of accounts",
            "name:cs": "Účtový rozvrh",
            "name:en": "Chart of accounts",
            "icon": "calculator",
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountsViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_accounting_accounts",
            "id": "economy.accounting.accounts"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountDocument"
        }
    ],

    "lookups": [
        {
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountsLookup"
        }
    ],

    "config": [
        {
            "id": "economy.accounting.accountLevels",
            "file": "config/accountLevels.jsonc"
        },
        {
            "id": "economy.accounting.accountKinds",
            "file": "config/accountKinds.jsonc"
        },
        {
            "id": "economy.accounting.costsTypes",
            "file": "config/costsTypes.jsonc"
        },
        {
            "id": "economy.accounting.resultsTypes",
            "file": "config/resultsTypes.jsonc"
        },
        {
            "id": "economy.accounting.accountingStates",
            "file": "config/accountingStates.jsonc"
        },
        {
            "id": "economy.accounting.rules.cz",
            "file": "config/accountingRules.cz.jsonc"
        }
    ]
}
