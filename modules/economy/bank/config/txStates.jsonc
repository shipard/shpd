{
    // economy.bank.txStates
    //
    // Stavová mapa bankovní transakce (economy_bank_transactions).
    // Vlastní sada — paralela k docStatesArchive, ale s účetním triggerem.
    //
    // Stavový automat:
    //   Nová       → Zaúčtováno | V opravě | Smazáno
    //   V opravě   → Zaúčtováno | Smazáno
    //   Zaúčtováno → V opravě | Smazáno
    //   Smazáno    → V opravě
    //
    // Přechod DO 40 (Zaúčtováno) spustí bankovní mikroengine (Fáze 3):
    // zápis řádků do účetního deníku a nastavení accounting_state.
    // Přechod ZE 40 (→ 80/90) řádky deníku smaže, accounting_state = 0.
    // Účtování nikdy neblokuje přechod (nedohledaný účet → accounting_state = 2).

    "10": {
        "stateName": "New",
        "stateName:cs": "Nová",
        "stateName:en": "New",
        "actionName": "Mark as new",
        "actionName:cs": "Vrátit na Novou",
        "actionName:en": "Mark as new",
        "stateStyle": "concept",
        "mainState": 1,
        "viewGroup": "active",
        "closeForm": 0,
        "goto": [40, 80, 90]
    },

    "40": {
        "stateName": "Accounted",
        "stateName:cs": "Zaúčtováno",
        "stateName:en": "Accounted",
        "actionName": "Account",
        "actionName:cs": "Zaúčtovat",
        "actionName:en": "Account",
        "stateStyle": "done",
        "mainState": 3,
        "viewGroup": "active",
        "readOnly": 1,
        "closeForm": 1,
        "goto": [80, 90]
    },

    "80": {
        "stateName": "In repair",
        "stateName:cs": "V opravě",
        "stateName:en": "In repair",
        "actionName": "Reopen for editing",
        "actionName:cs": "Otevřít k úpravě",
        "actionName:en": "Reopen for editing",
        "stateStyle": "edit",
        "mainState": 2,
        "viewGroup": "active",
        "closeForm": 0,
        "goto": [40, 90]
    },

    "90": {
        "stateName": "Deleted",
        "stateName:cs": "Smazáno",
        "stateName:en": "Deleted",
        "actionName": "Delete",
        "actionName:cs": "Smazat",
        "actionName:en": "Delete",
        "stateStyle": "trash",
        "mainState": 5,
        "viewGroup": "trash",
        "readOnly": 1,
        "closeForm": 1,
        "goto": [80]
    }
}
