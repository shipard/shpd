{
    // Editační form bankovní transakce. Transakce vzniká importem/migrací, ne
    // ručně (viewer nemá Add), takže form je vždy edit: měnitelné jsou jen
    // operation / partner / message; ostatní pole jsou read-only kontext.
    // Plnou prezentaci (vč. účtu, výpisu) nese detail vieweru.

    "title": "Bankovní transakce",
    "title:cs": "Bankovní transakce",
    "title:en": "Bank transaction",
    "titleNew": "Bankovní transakce",
    "titleNew:cs": "Bankovní transakce",
    "titleNew:en": "Bank transaction",
    "tabs": [
        {
            "id": "basic",
            "label": "Transakce",
            "label:cs": "Transakce",
            "label:en": "Transaction",
            "sections": [
                {
                    "columns": [
                        {
                            "elements": [
                                {"type": "input",  "column": "date_transaction", "readOnly": true},
                                {"type": "input",  "column": "date_value",       "readOnly": true},
                                {"type": "select", "column": "direction",        "readOnly": true},
                                {"type": "input",  "column": "amount",           "readOnly": true},
                                {"type": "select", "column": "currency",         "readOnly": true},
                                {"type": "input",  "column": "amount_dom",       "readOnly": true},

                                {"type": "separator", "label": "Protistrana", "label:cs": "Protistrana", "label:en": "Counterparty"},
                                {"type": "input", "column": "counterparty_account", "readOnly": true},
                                {"type": "input", "column": "counterparty_name",    "readOnly": true},
                                {"type": "input", "column": "payment_reference",    "readOnly": true},
                                {"type": "input", "column": "specific_symbol",      "readOnly": true},
                                {"type": "input", "column": "constant_symbol",      "readOnly": true},

                                {"type": "separator", "label": "Zaúčtování", "label:cs": "Zaúčtování", "label:en": "Accounting"},
                                {"type": "select", "column": "operation"},
                                {
                                    "type": "lookup",
                                    "column": "partner",
                                    "placeholder": "Vyhledat partnera…",
                                    "lookup": {"table": "base_persons_persons", "filter": null}
                                },
                                {"type": "input", "column": "message"}
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
