                {"type": "input", "column": "bic", "cols": 2},

                {"type": "separator", "label": "Nastavení", "label:cs": "Nastavení", "label:en": "Settings"},
                {"type": "input", "column": "is_default", "cols": 1},
                {"type": "input", "column": "sort_order", "cols": 1},
