{
    "title": "Bankovní spojení",
    "title:cs": "Bankovní spojení",
    "title:en": "Bank account",
    "titleNew": "Nové bankovní spojení",
    "titleNew:cs": "Nové bankovní spojení",
    "titleNew:en": "New bank account",
    "tabs": [
        {
            "id": "basic",
            "label": "Účet",
            "label:cs": "Účet",
            "label:en": "Account",
            "sections": [
                {
                    "columns": [
                        {
                            "elements": [
                                {"type": "input", "column": "code", "required": true},
                                {"type": "input", "column": "name", "required": true},
                                {"type": "input", "column": "currency", "required": true},
                                {"type": "input", "column": "notice"},

                                {"type": "separator", "label": "Bankovní údaje", "label:cs": "Bankovní údaje", "label:en": "Bank details"},
                                {"type": "input", "column": "bank_name"},
                                {"type": "input", "column": "account_number"},
                                {"type": "input", "column": "iban"},
                                {"type": "input", "column": "bic"},
                                {"type": "input", "column": "ebanking_id"},

                                {"type": "separator", "label": "Nastavení", "label:cs": "Nastavení", "label:en": "Settings"},
                                {
                                    "type": "lookup",
                                    "column": "accounting_account",
                                    "placeholder": "Hledat účet 221…",
                                    "lookup": {"table": "economy_accounting_accounts", "filter": {"account_level": 4, "number_prefix": "221"}}
                                },
                                {"type": "input", "column": "is_default"},
                                {"type": "input", "column": "sort_order"},
                                {"type": "input", "column": "valid_from"},
                                {"type": "input", "column": "valid_to"}
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
