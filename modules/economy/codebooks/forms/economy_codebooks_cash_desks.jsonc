{
    "title": "Pokladna",
    "title:cs": "Pokladna",
    "title:en": "Cash desk",
    "titleNew": "Nová pokladna",
    "titleNew:cs": "Nová pokladna",
    "titleNew:en": "New cash desk",
    "tabs": [
        {
            "id": "basic",
            "label": "Pokladna",
            "label:cs": "Pokladna",
            "label:en": "Cash desk",
            "sections": [
                {
                    "columns": [
                        {
                            "elements": [
                                {"type": "input", "column": "code", "required": true},
                                {"type": "input", "column": "name", "required": true},
                                {"type": "select", "column": "currency", "required": true},
                                {"type": "input", "column": "notice"},

                                {"type": "separator", "label": "Nastavení", "label:cs": "Nastavení", "label:en": "Settings"},
                                // accounting_account je extension z economy.accounting — bez
                                // toho modulu sloupec neexistuje a loader `optional` element vynechá.
                                {
                                    "type": "lookup",
                                    "column": "accounting_account",
                                    "optional": true,
                                    "placeholder": "Hledat účet 211…",
                                    "lookup": {"table": "economy_accounting_accounts", "filter": {"account_level": 4, "number_prefix": "211"}}
                                },
                                {"type": "input", "column": "is_default"},
                                {"type": "input", "column": "sort_order"},
                                {"type": "input", "column": "valid_from"},
                                {"type": "input", "column": "valid_to"}
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
