{
    "tableId": 318,
    "name": "Bank accounts",
    "name:cs": "Bankovní spojení",
    "name:en": "Bank accounts",

    "displayPattern": "{code} — {name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "account",
            "name": "Bank account",
            "name:cs": "Bankovní účet",
            "name:en": "Bank account"
        },
        {
            "id": "settings",
            "name": "Settings",
            "name:cs": "Nastavení",
            "name:en": "Settings"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "code",
            "name": "Code",
            "name:cs": "Kód",
            "name:en": "Code",
            "type": "varchar",
            "length": 10,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 150,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "notice",
            "name": "Notice",
            "name:cs": "Poznámka",
            "name:en": "Notice",
            "type": "varchar",
            "length": 250,
            "nullable": true,
            "group": "identity"
        },

        // --- account ---

        {
            "id": "bank_name",
            "name": "Bank name",
            "name:cs": "Název banky",
            "name:en": "Bank name",
            "type": "varchar",
            "length": 150,
            "nullable": true,
            "group": "account"
        },
        {
            "id": "account_number",
            "name": "Account number",
            "name:cs": "Číslo účtu",
            "name:en": "Account number",
            "type": "varchar",
            "length": 40,
            "nullable": true,
            "group": "account"
        },
        {
            "id": "iban",
            "name": "IBAN",
            "name:cs": "IBAN",
            "name:en": "IBAN",
            "type": "varchar",
            "length": 34,
            "nullable": true,
            "group": "account"
        },
        {
            "id": "bic",
            "name": "BIC/SWIFT",
            "name:cs": "BIC/SWIFT",
            "name:en": "BIC/SWIFT",
            "type": "varchar",
            "length": 11,
            "nullable": true,
            "group": "account"
        },

        // --- settings ---

        {
            "id": "currency",
            "name": "Currency",
            "name:cs": "Měna",
            "name:en": "Currency",
            "type": "varchar",
            "length": 3,
            "nullable": false,
            "default": "czk",
            "group": "settings"
        },
        {
            "id": "is_default",
            "name": "Default",
            "name:cs": "Výchozí",
            "name:en": "Default",
            "type": "boolean",
            "default": 0,
            "nullable": false,
            "group": "settings"
        },
        {
            "id": "valid_from",
            "name": "Valid from",
            "name:cs": "Platnost od",
            "name:en": "Valid from",
            "type": "date",
            "nullable": true,
            "group": "settings"
        },
        {
            "id": "valid_to",
            "name": "Valid to",
            "name:cs": "Platnost do",
            "name:en": "Valid to",
            "type": "date",
            "nullable": true,
            "group": "settings"
        },
        {
            "id": "sort_order",
            "name": "Order",
            "name:cs": "Pořadí",
            "name:en": "Order",
            "type": "smallint",
            "default": 0,
            "nullable": false,
            "group": "settings"
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_code",
            "type": "unique",
            "columns": [
                {"column": "code"}
            ]
        },
        {
            "id": "idx_sort_order",
            "type": "index",
            "columns": [
                {"column": "sort_order", "order": "ASC"},
                {"column": "name", "order": "ASC"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "sort_order", "order": "ASC"}
            ]
        },
        {
            "id": "idx_iban",
            "type": "index",
            "columns": [
                {"column": "iban"}
            ]
        }
    ]
}
