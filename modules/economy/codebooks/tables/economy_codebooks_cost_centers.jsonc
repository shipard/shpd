{
    "tableId": 102,
    "displayPattern": "{code} — {name}",
    "name": "Cost centers",
    "name:cs": "Střediska",
    "name:en": "Cost centers",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "settings",
            "name": "Settings",
            "name:cs": "Nastavení",
            "name:en": "Settings"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "code",
            "name": "Code",
            "name:cs": "Kód",
            "name:en": "Code",
            "type": "varchar",
            "length": 10,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 150,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "valid_from",
            "name": "Valid from",
            "name:cs": "Platnost od",
            "name:en": "Valid from",
            "type": "date",
            "nullable": true,
            "group": "settings"
        },
        {
            "id": "valid_to",
            "name": "Valid to",
            "name:cs": "Platnost do",
            "name:en": "Valid to",
            "type": "date",
            "nullable": true,
            "group": "settings"
        },
        {
            "id": "sort_order",
            "name": "Sort order",
            "name:cs": "Pořadí",
            "name:en": "Sort order",
            "type": "smallint",
            "nullable": false,
            "default": 0,
            "group": "settings"
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "nullable": false,
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "nullable": false,
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_code",
            "type": "unique",
            "columns": [
                {"column": "code"}
            ]
        },
        {
            "id": "idx_sort_order",
            "type": "index",
            "columns": [
                {"column": "sort_order", "order": "ASC"},
                {"column": "name", "order": "ASC"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "sort_order", "order": "ASC"}
            ]
        }
    ]
}
