{
    "tableId": 316,
    "name": "VAT periods",
    "name:cs": "Období DPH",
    "name:en": "VAT periods",

    "displayPattern": "{name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "vat_registration",
            "name": "VAT registration",
            "name:cs": "Registrace DPH",
            "name:en": "VAT registration",
            "type": "int",
            "nullable": false,
            "reference": "economy_codebooks_vat_registrations"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 20,
            "nullable": false
        },
        {
            "id": "date_begin",
            "name": "Begin date",
            "name:cs": "Začátek období",
            "name:en": "Begin date",
            "type": "date",
            "nullable": false
        },
        {
            "id": "date_end",
            "name": "End date",
            "name:cs": "Konec období",
            "name:en": "End date",
            "type": "date",
            "nullable": false
        },
        {
            "id": "locked",
            "name": "Locked",
            "name:cs": "Uzamčeno",
            "name:en": "Locked",
            "type": "boolean",
            "default": 0,
            "nullable": false
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "idx_vat_registration",
            "type": "index",
            "columns": [
                {"column": "vat_registration"},
                {"column": "date_begin"}
            ]
        },
        {
            "id": "idx_dates",
            "type": "index",
            "columns": [
                {"column": "date_begin"},
                {"column": "date_end"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "date_begin", "order": "DESC"}
            ]
        }
    ]
}
