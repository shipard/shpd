{
    "tableId": 311,
    "name": "Items",
    "name:cs": "Položky",
    "name:en": "Items",

    "displayPattern": "{code} — {name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "classification",
            "name": "Classification",
            "name:cs": "Klasifikace",
            "name:en": "Classification"
        },
        {
            "id": "details",
            "name": "Details",
            "name:cs": "Detaily",
            "name:en": "Details"
        },
        {
            "id": "pricing",
            "name": "Pricing",
            "name:cs": "Cena",
            "name:en": "Pricing"
        },
        {
            "id": "lineage",
            "name": "Lineage",
            "name:cs": "Původ záznamu",
            "name:en": "Lineage"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "code",
            "name": "Code",
            "name:cs": "Kód",
            "name:en": "Code",
            "type": "varchar",
            "length": 25,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "sku",
            "name": "SKU",
            "name:cs": "SKU",
            "name:en": "SKU",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "ean",
            "name": "EAN",
            "name:cs": "EAN",
            "name:en": "EAN",
            "type": "varchar",
            "length": 20,
            "nullable": true,
            "group": "identity"
        },

        // --- classification ---

        {
            "id": "item_kind",
            "name": "Item kind",
            "name:cs": "Druh položky",
            "name:en": "Item kind",
            "type": "int",
            "nullable": false,
            "reference": "economy_items_kinds",
            "group": "classification"
        },
        {
            "id": "item_type",
            "name": "Item type",
            "name:cs": "Typ položky",
            "name:en": "Item type",
            "type": "enumInt",
            "default": 3,
            "cfgItem": "economy.items.itemTypes",
            "group": "classification"
        },
        {
            "id": "content_tags",
            "name": "Content tags",
            "name:cs": "Obsahové štítky",
            "name:en": "Content tags",
            "type": "json",
            "nullable": true,
            "group": "classification"
            // List klíčů z cfgItem core.exchange.contentTags (obsahová
            // eskalace párování, tasks/content-tag-enrichment.md).
            // Serializaci řeší ItemDocument (prázdný výběr → NULL).
        },

        // --- details ---

        {
            "id": "description",
            "name": "Description",
            "name:cs": "Popis",
            "name:en": "Description",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "details"
        },
        {
            "id": "valid_from",
            "name": "Valid from",
            "name:cs": "Platnost od",
            "name:en": "Valid from",
            "type": "date",
            "nullable": true,
            "group": "details"
        },
        {
            "id": "valid_to",
            "name": "Valid to",
            "name:cs": "Platnost do",
            "name:en": "Valid to",
            "type": "date",
            "nullable": true,
            "group": "details"
        },

        // --- pricing ---

        {
            "id": "sales_price_no_vat",
            "name": "Sales price (no VAT)",
            "name:cs": "Prodejní cena bez DPH",
            "name:en": "Sales price (no VAT)",
            "type": "numeric",
            "precision": 15,
            "scale": 4,
            "nullable": true,
            "group": "pricing"
        },
        {
            "id": "unit",
            "name": "Unit",
            "name:cs": "Jednotka",
            "name:en": "Unit",
            "type": "int",
            "nullable": false,
            "reference": "core_units",
            "group": "pricing"
        },

        // --- lineage ---

        {
            "id": "source_kind",
            "name": "Source kind",
            "name:cs": "Zdroj záznamu",
            "name:en": "Source kind",
            "type": "varchar",
            "length": 40,
            "nullable": true,
            "cfgItem": "economy.items.sourceKinds",
            "group": "lineage"
        },
        {
            "id": "source_ref",
            "name": "Source reference",
            "name:cs": "Identifikátor ve zdroji",
            "name:en": "Source reference",
            "type": "varchar",
            "length": 60,
            "nullable": true,
            "group": "lineage"
        },
        {
            "id": "source_imported_at",
            "name": "Imported at",
            "name:cs": "Importováno",
            "name:en": "Imported at",
            "type": "datetime",
            "nullable": true,
            "group": "lineage"
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_code",
            "type": "unique",
            "columns": [
                {"column": "code"}
            ]
        },
        {
            "id": "idx_item_kind",
            "type": "index",
            "columns": [
                {"column": "item_kind"}
            ]
        },
        {
            "id": "idx_item_type",
            "type": "index",
            "columns": [
                {"column": "item_type"}
            ]
        },
        {
            "id": "idx_unit",
            "type": "index",
            "columns": [
                {"column": "unit"}
            ]
        },
        {
            "id": "idx_sku",
            "type": "index",
            "columns": [
                {"column": "sku"}
            ]
        },
        {
            "id": "idx_ean",
            "type": "index",
            "columns": [
                {"column": "ean"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "name", "order": "ASC"}
            ]
        },
        {
            "id": "ft_name",
            "type": "fulltext",
            "columns": [
                {"column": "name"},
                {"column": "description"}
            ]
        }
    ]
}
