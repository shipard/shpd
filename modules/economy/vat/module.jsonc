{
    "id": "economy.vat",
    "name": "VAT",
    "name:cs": "DPH",
    "name:en": "VAT",
    "description": "VAT outputs: live VAT return, control statement and recapitulative statement computed on demand from confirmed documents (issue #55, M1)",
    "description:cs": "Výstupy DPH: živé přiznání, kontrolní hlášení a souhrnné hlášení počítané on-demand z potvrzených dokladů (issue #55, M1)",
    "description:en": "VAT outputs: live VAT return, control statement and recapitulative statement computed on demand from confirmed documents (issue #55, M1)",

    // world.vat = kódy DPH (legislativní vrstva bez výkaznických konvencí, D3),
    // economy.codebooks = registrace + období DPH, docs.core = doklady
    // a vat_recap, economy.accounting = deník pro křížovou kontrolu 343.
    "dependencies": ["world.vat", "economy.codebooks", "docs.core", "economy.accounting"],

    "tables": [
        "economy_vat_report_periods"
    ],

    // Zařazení dokladu do instancí tvrzení (vat_period / cs_period /
    // rs_period, D13) — docs.core na economy.vat nezávisí.
    "extensions": [
        "docs_core_heads"
    ],

    "documentEventHandlers": [
        {
            // Save-time přiřazení instancí (D8) + on-demand koncept (D9).
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Vat\\DocsHeadsVatPeriodHandler",
            "events": ["beforeSave"]
        },
        {
            // Seed instancí běžného období po uložení registrace DPH
            // (dřív afterSave hook registrace v economy.codebooks).
            "table": "economy_codebooks_vat_registrations",
            "class": "Shipard\\Module\\Economy\\Vat\\VatRegistrationSeedHandler",
            "events": ["afterSave"]
        }
    ],

    "alertChecks": [
        {
            "id": "economy.vat.draft_report_periods",
            "name": "Draft VAT report periods",
            "name:cs": "Koncepty daňových tvrzení",
            "name:en": "Draft VAT report periods",
            "description": "Report period instances created on demand while saving a document — review the range and confirm them.",
            "description:cs": "Instance tvrzení založené automaticky při uložení dokladu — zkontrolujte rozsah a potvrďte je.",
            "description:en": "Report period instances created on demand while saving a document — review the range and confirm them.",
            "class": "Shipard\\Module\\Economy\\Vat\\Checks\\DraftReportPeriodsCheck",
            "severity": "warning",
            "interval": "15m",
            "navSection": "accounting",
            "tags": ["vat", "periods"]
        }
    ],

    "config": [
        { "id": "economy.vat.reports.cz", "file": "config/vat-reports-cz.jsonc" },
        { "id": "economy.vat.reportTypes", "file": "config/reportTypes.jsonc" }
    ],

    "viewers": [
        {
            // Instance daňových tvrzení (D7) — vedle živých reportů v sekci
            // účetnictví; registrace zůstávají v Nastavení.
            "id": "economy.vat.reportPeriods",
            "name": "VAT report periods",
            "name:cs": "Daňová tvrzení",
            "name:en": "VAT report periods",
            "icon": "calendar",
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodsViewer",
            "navSection": "accounting",
            "navOrder": 50
        }
    ],

    "forms": [
        {
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodsForm"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodDocument"
        }
    ],

    "reports": [
        { "file": "config/reports.jsonc" }
    ]
}
