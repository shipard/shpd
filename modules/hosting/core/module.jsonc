{
    "id": "hosting.core",
    "name": "Hosting",
    "name:cs": "Hosting",
    "name:en": "Hosting",
    "description": "Central management of Shipard data sources — servers, data sources, user↔DS links, portal for users",
    "description:cs": "Centrální správa zdrojů dat Shipard — servery, zdroje dat, vazby uživatel↔DS, portál pro uživatele",
    "description:en": "Central management of Shipard data sources — servers, data sources, user↔DS links, portal for users",

    "dependencies": [
        "core.system"
    ],

    "tables": [
        "hosting_core_servers",
        "hosting_core_data_sources",
        "hosting_core_ds_users",
        "hosting_core_oidc_codes",
        "hosting_core_mail_routers"
    ],

    "documentClasses": [
        {
            "table": "hosting_core_data_sources",
            "class": "Shipard\\Module\\Hosting\\Core\\HostingDataSourceDocument"
        },
        {
            "table": "hosting_core_mail_routers",
            "class": "Shipard\\Module\\Hosting\\Core\\MailRouterDocument"
        }
    ],

    "settingsItems": [
        { "viewer": "hosting.core.servers",     "section": "other", "subsection": "other.hosting", "order": 10 },
        { "viewer": "hosting.core.dataSources", "section": "other", "subsection": "other.hosting", "order": 20 },
        { "viewer": "hosting.core.mailRouters", "section": "other", "subsection": "other.hosting", "order": 25 },
        { "viewer": "hosting.core.dsUsers",     "section": "other", "subsection": "other.hosting", "order": 30 },
        { "page": "hostingOidc",                "section": "other", "subsection": "other.hosting", "order": 40 }
    ],

    "settingsPages": [
        {
            "id": "hostingOidc",
            "name": "Hosting",
            "name:cs": "Hosting",
            "name:en": "Hosting",
            "icon": "lock",
            "adminOnly": true,
            "fields": [
                {
                    "id": "hosting.baseDomain",
                    "type": "text",
                    "name": "Base domain",
                    "name:cs": "Základní doména",
                    "name:en": "Base domain",
                    "hint": "Domain for new data sources — url_app is derived as https://{web_id}.{baseDomain} (e.g. shpd.dev).",
                    "hint:cs": "Doména nových zdrojů dat — url_app se odvozuje jako https://{web_id}.{baseDomain} (např. shpd.dev).",
                    "hint:en": "Domain for new data sources — url_app is derived as https://{web_id}.{baseDomain} (e.g. shpd.dev).",
                    "maxLength": 100
                },
                {
                    "id": "hosting.oidc.issuer",
                    "type": "text",
                    "name": "Issuer URL",
                    "name:cs": "Issuer URL",
                    "name:en": "Issuer URL",
                    "hint": "Permanent value, e.g. https://host/api/v1/_hosting/oidc (dev: http://127.0.0.1/{ds-id}/api/v1/_hosting/oidc). Changing it invalidates all linked identities on client data sources (D12).",
                    "hint:cs": "Trvalá hodnota, např. https://host/api/v1/_hosting/oidc (dev: http://127.0.0.1/{ds-id}/api/v1/_hosting/oidc). Změna zneplatní všechny navázané identity na klientských DS (D12).",
                    "hint:en": "Permanent value, e.g. https://host/api/v1/_hosting/oidc (dev: http://127.0.0.1/{ds-id}/api/v1/_hosting/oidc). Changing it invalidates all linked identities on client data sources (D12).",
                    "maxLength": 200
                }
            ]
        }
    ],

    "viewers": [
        {
            "id": "hosting.core.servers",
            "name": "Servers",
            "name:cs": "Servery",
            "name:en": "Servers",
            "icon": "server",
            "table": "hosting_core_servers",
            "class": "Shipard\\Module\\Hosting\\Core\\ServersViewer"
        },
        {
            "id": "hosting.core.dataSources",
            "name": "Data sources",
            "name:cs": "Zdroje dat",
            "name:en": "Data sources",
            "icon": "database",
            "table": "hosting_core_data_sources",
            "class": "Shipard\\Module\\Hosting\\Core\\DataSourcesViewer"
        },
        {
            "id": "hosting.core.dsUsers",
            "name": "Data source users",
            "name:cs": "Uživatelé zdrojů dat",
            "name:en": "Data source users",
            "icon": "users",
            "table": "hosting_core_ds_users",
            "class": "Shipard\\Module\\Hosting\\Core\\DsUsersViewer"
        },
        {
            "id": "hosting.core.mailRouters",
            "name": "Mail routers",
            "name:cs": "Mail-routery",
            "name:en": "Mail routers",
            "icon": "mail",
            "table": "hosting_core_mail_routers",
            "class": "Shipard\\Module\\Hosting\\Core\\MailRoutersViewer"
        }
    ],

    "forms": [
        {
            "table": "hosting_core_servers",
            "class": "Shipard\\Module\\Hosting\\Core\\ServersForm"
        },
        {
            "table": "hosting_core_data_sources",
            "class": "Shipard\\Module\\Hosting\\Core\\DataSourcesForm"
        },
        {
            "table": "hosting_core_ds_users",
            "class": "Shipard\\Module\\Hosting\\Core\\DsUsersForm"
        },
        {
            "table": "hosting_core_mail_routers",
            "class": "Shipard\\Module\\Hosting\\Core\\MailRoutersForm"
        }
    ],

    "config": [
        {
            "id": "hosting.core.dsLifecycle",
            "file": "config/dsLifecycle.jsonc"
        },
        {
            "id": "hosting.core.dsUserRoles",
            "file": "config/dsUserRoles.jsonc"
        }
    ]
}
