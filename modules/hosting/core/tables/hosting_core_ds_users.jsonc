{
    "tableId": 432,
    "name": "Hosting data source users",
    "name:cs": "Hosting — uživatelé zdrojů dat",
    "name:en": "Hosting data source users",

    "adminOnly": true,

    "displayPattern": "{id}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "link",
            "name": "Link",
            "name:cs": "Vazba",
            "name:en": "Link"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- link ---

        {
            "id": "user",
            "name": "User",
            "name:cs": "Uživatel",
            "name:en": "User",
            "type": "int",
            "nullable": false,
            "reference": "core_system_users",
            "group": "link"
        },
        {
            "id": "data_source",
            "name": "Data source",
            "name:cs": "Zdroj dat",
            "name:en": "Data source",
            "type": "int",
            "nullable": false,
            "reference": "hosting_core_data_sources",
            "group": "link"
        },
        {
            "id": "role",
            "name": "Role",
            "name:cs": "Role",
            "name:en": "Role",
            "type": "enumString",
            "length": 10,
            "cfgItem": "hosting.core.dsUserRoles",
            "nullable": false,
            "default": "member",
            "group": "link"
        },
        {
            "id": "last_entered",
            "name": "Last entered",
            "name:cs": "Poslední vstup",
            "name:en": "Last entered",
            "type": "datetime",
            "nullable": true,
            "group": "link"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "modified",
            "name": "Modified",
            "name:cs": "Změněno",
            "name:en": "Modified",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 40,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 3,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_user_data_source",
            "type": "unique",
            "columns": [
                {"column": "user"},
                {"column": "data_source"}
            ]
        },
        {
            "id": "idx_data_source",
            "type": "index",
            "columns": [
                {"column": "data_source"}
            ]
        }
    ]
}
