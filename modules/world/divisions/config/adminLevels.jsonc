{
    // =========================================================================
    // Definice úrovní administrativního členění per země
    //
    // Klíč = ISO 3166-1 alpha-2 kód země (malými písmeny)
    //
    // Čísla úrovní (level) jsou specifická pro každou zemi. V rámci jedné
    // země platí: nižší číslo = vyšší (nadřazená) úroveň.
    // Čísla nemusí být po sobě jdoucí — Česko používá 0–2 pro hlavní
    // hierarchii a 10–11 pro speciální úrovně (ORP, ZUJ).
    // =========================================================================

    // -----------------------------------------------------------------
    // Česko
    //
    // Hierarchie: Region → Kraj → Okres → ORP → ZUJ
    // Zdroj: ČSÚ (Český statistický úřad)
    // -----------------------------------------------------------------
    "cz": {
        "name": "Czech Administrative Divisions",
        "name:cs": "Administrativní členění Česka",
        "name:en": "Czech Administrative Divisions",
        "source": "ČSÚ",
        "levels": [
            {
                "level": 0,
                "name": "Region",
                "name:cs": "Region",
                "name:en": "Region",
                "note": "Region soudržnosti (NUTS 2)",
                "note:cs": "Region soudržnosti (NUTS 2)",
                "note:en": "Cohesion region (NUTS 2)",
            },
            {
                "level": 1,
                "name": "County",
                "name:cs": "Kraj",
                "name:en": "County",
                "note": "Vyšší územní samosprávný celek (NUTS 3)",
                "note:cs": "Vyšší územní samosprávný celek (NUTS 3)",
                "note:en": "Higher territorial self-governing unit (NUTS 3)",
            },
            {
                "level": 2,
                "name": "District",
                "name:cs": "Okres",
                "name:en": "District",
                "note": "LAU 1",
                "note:cs": "LAU 1",
                "note:en": "LAU 1",
            },
            {
                "level": 10,
                "name": "Municipality with Extended Powers",
                "name:cs": "ORP",
                "name:en": "Municipality with Extended Powers",
                "note": "Obec s rozšířenou působností",
                "note:cs": "Obec s rozšířenou působností",
                "note:en": "Municipality with extended powers (delegated state administration)",
            },
            {
                "level": 11,
                "name": "Basic Territorial Unit",
                "name:cs": "ZUJ",
                "name:en": "Basic Territorial Unit",
                "note": "Základní územní jednotka (obec)",
                "note:cs": "Základní územní jednotka (obec)",
                "note:en": "Basic territorial unit (municipality, LAU 2)",
            },
        ],
    },

