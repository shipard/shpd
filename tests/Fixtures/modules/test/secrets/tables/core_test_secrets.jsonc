// Canary table — exists ONLY in the test fixture.
// Demonstrates that an encrypted_text column round-trips through Document
// hooks without leaking plaintext into the database.
{
    "tableId": 9001,
    "name": "core_test_secrets",
    "displayPattern": "{label}",
    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "primaryKey": true,
            "autoIncrement": true,
            "nullable": false,
            "system": true
        },
        {
            "id": "label",
            "name": "Label",
            "type": "varchar",
            "length": 100,
            "nullable": false
        },
        {
            "id": "api_key",
            "name": "API key",
            "type": "encrypted_text",
            "nullable": true,
            "group": "credentials"
        }
    ]
}
